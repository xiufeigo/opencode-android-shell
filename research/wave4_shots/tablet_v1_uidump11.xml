lse" selected="false" bounds="[1254,56][1485,112]" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1477,36][1573,132]"><node index="0" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="新建会话" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1509,68][1541,100]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1497,56][1553,112]" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,240][2560,1412]"><node index="0" text="已中断" resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1241,1102][1319,1139]" /><node index="1" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,240][2528,956]"><node index="0" text="Crucially, engineers wanted both NoSQL scale and SQL guarantees. This led to NewSQL: distributed relational systems that preserve ACID and SQL while scaling horizontally. Google Spanner pioneered globally synchronized clocks with TrueTime to provide externally consistent transactions across continents. Followers like CockroachDB, YugabyteDB, TiDB, and PlanetScale with Vitess brought similar ideas to open source and MySQL compatibility. Even traditional NoSQL systems added transactions: MongoDB added multi-document ACID transactions in 2018, and document stores added SQL-like query languages." resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,240][2528,391]" /><node index="1" text="The lesson of the 2010s was convergence. Relational systems learned to scale out and store JSON. NoSQL systems learned to join, filter with SQL, and guarantee correctness. PostgreSQL, through extensions like PostGIS, JSONB, TimescaleDB, Citus, and pgvector, became a multi-model platform rather than just a relational store." resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,415][2528,505]" /><node index="2" text="1." resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[56,545][104,590]" /><node index="3" text="The Modern Era: Real-Time, Vectors, and Intelligence" resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[104,545][2528,590]" /><node index="4" text="Today, in the mid-2020s, databases are no longer passive stores. They are active, distributed, real-time platforms embedded in every application." resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,614][2528,659]" /><node index="5" text="Three trends define the present." resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,683][2460,728]" /><node index="6" text="First, real-time and streaming. Users expect live dashboards, fraud detection in milliseconds, and instant recommendations. Systems like Apache Kafka, Flink, ClickHouse, Druid, and Rockset blur the line between transactional and analytical processing, enabling HTAP — Hybrid Transactional/Analytical Processing. Change-data-capture streams every insert from Postgres into warehouses and search indexes within seconds." resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,752][2528,887]" /><node index="7" text="Second, multi-model and specialized engines for new" resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,911][2528,956]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1865,964][1961,1060]"><node index="0" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="复制回复" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1899,998][1927,1026]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1889,988][1937,1036]" /></node><node index="3" text="Build · muse-spark-1.3-contributor · 33 秒 · 已中断" resource-id="" class="android.widget.TextView" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1961,995][2528,1030]" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.xiufeigo.opencodeshell" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0