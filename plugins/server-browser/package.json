{
  "name": "opencode-server-browser",
  "version": "0.1.0",
  "description": "Session browsers hosted by an OpenCode v2 server, shared by Android and web clients",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": { ".": "./dist/index.js", "./server": "./dist/index.js", "./rpc": "./dist/rpc.js" },
  "files": ["dist", "server.js", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "install-browser": "playwright install chromium",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.26",
    "@opencode/schema": "2.0.26",
    "effect": "4.0.0-rc.112",
    "playwright": "1.59.1"
  },
  "devDependencies": { "@types/node": "22.18.6", "tsx": "4.20.6", "typescript": "5.9.3" }
}
