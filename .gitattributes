# Keep Android source adapters portable across Windows and Linux checkouts.
frontend/android/** text eol=lf
frontend/remote-browser/** text eol=lf
plugins/server-browser/src/** text eol=lf
research/desktop-parity/** text eol=lf
scripts/verify-android-menus-device.mjs text eol=lf

# A unified diff needs a single-space prefix on empty context lines.
frontend/android/*.patch whitespace=-blank-at-eol

# Packaged UI must preserve the exact bytes produced by the pinned build.
webapp/src/main/assets/www/ui/** -text
