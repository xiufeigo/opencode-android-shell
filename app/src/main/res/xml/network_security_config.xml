<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN OpenCode backends are typically plain HTTP (e.g. http://192.168.x.x:4096). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- System CAs cover public HTTPS (e.g. Let's Encrypt). User CAs cover
                 private/custom CA backends installed in Android settings. -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
