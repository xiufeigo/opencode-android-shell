<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oc_bg_base">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/chat_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@color/oc_bg_base"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/oc_open_sessions"
                android:padding="8dp"
                android:src="@drawable/ic_oc_menu" />

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/oc_new_session"
                android:textColor="@color/oc_text_base"
                android:textSize="14sp"
                android:textFontWeight="500" />

            <com.xiufeigo.opencodeshell.ContextRingView
                android:id="@+id/context_ring"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/oc_context_usage" />
        </LinearLayout>

        <View
            android:id="@+id/header_divider"
            android:layout_width="0dp"
            android:layout_height="1px"
            android:background="@color/oc_border_base"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chat_header" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toTopOf="@id/composer_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_divider" />

        <LinearLayout
            android:id="@+id/chat_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chat_error"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_divider">

            <TextView
                android:id="@+id/chat_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oc_error_title"
                android:textColor="@color/oc_danger_fg"
                android:textSize="12sp"
                android:textFontWeight="500" />

            <TextView
                android:id="@+id/chat_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/oc_danger_fg"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/composer_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <HorizontalScrollView
                android:id="@+id/attachment_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attachment_strip_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="2dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/composer_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_composer_panel"
                android:elevation="2dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/composer_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/oc_composer_hint"
                    android:imeOptions="actionSend|flagNoEnterAction"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxHeight="180dp"
                    android:minHeight="60dp"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/oc_text_base"
                    android:textColorHint="@color/oc_text_faint"
                    android:textSize="13sp"
                    android:textFontWeight="500" />

                <LinearLayout
                    android:id="@+id/composer_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/btn_attach"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/chat_attach"
                        android:padding="2dp"
                        android:src="@drawable/ic_oc_plus"
                        android:tint="@color/oc_icon_muted" />

                    <LinearLayout
                        android:id="@+id/model_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_oc_model"
                            android:tint="@color/oc_icon_muted" />

                        <TextView
                            android:id="@+id/model_chip_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="220dp"
                            android:text="@string/oc_model_label"
                            android:textColor="@color/oc_text_base"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_oc_chevron_down"
                            android:tint="@color/oc_icon_muted" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btn_send"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_send_button"
                        android:contentDescription="@string/chat_send"
                        android:padding="2dp"
                        android:src="@drawable/ic_oc_send" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/session_drawer"
        layout="@layout/view_session_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
