diff --git a/packages/app/src/runtime/polyfills.ts b/packages/app/src/runtime/polyfills.ts
index edf61c8..d0636a5 100644
--- a/packages/app/src/runtime/polyfills.ts
+++ b/packages/app/src/runtime/polyfills.ts
@@ -37,3 +37,23 @@ if (!Promise.try) {
     return new Promise<T>((resolve) => resolve(callback(...args)))
   } as typeof Promise.try
 }
+
+// Android WebView before Chromium 126 lacks URL.parse, used by server pairing.
+const urlConstructor = URL as unknown as { parse?: (input: string, base?: string | URL) => URL | null }
+if (!urlConstructor.parse) {
+  urlConstructor.parse = function parse(input: string, base?: string | URL): URL | null {
+    if (typeof input !== "string") throw new TypeError("URL.parse requires a string")
+    if (base !== undefined) {
+      try {
+        new URL(String(base))
+      } catch {
+        throw new TypeError("Invalid base URL")
+      }
+    }
+    try {
+      return base === undefined ? new URL(input) : new URL(input, base)
+    } catch {
+      return null
+    }
+  }
+}
