diff --git a/packages/app/src/runtime/polyfills.test.ts b/packages/app/src/runtime/polyfills.test.ts
new file mode 100644
index 00000000..06954f8d
--- /dev/null
+++ b/packages/app/src/runtime/polyfills.test.ts
@@ -0,0 +1,18 @@
+import { expect, test } from "bun:test"
+import { pairingLink } from "../servers/connect/pairing"
+
+test("bootstrap supports server pairing without native URL.parse", async () => {
+  const descriptor = Object.getOwnPropertyDescriptor(URL, "parse")
+  Object.defineProperty(URL, "parse", { value: undefined, configurable: true, writable: true })
+  try {
+    await import("./polyfills")
+    expect(URL.parse("not a URL")).toBeNull()
+    expect(URL.parse("/auth/connect/abc", "http://host:4096")?.href).toBe("http://host:4096/auth/connect/abc")
+    expect(() => URL.parse()).toThrow(TypeError)
+    expect(pairingLink("http://host:4096/auth/connect/abc")).toEqual({ urls: ["http://host:4096"], code: "abc" })
+    expect(pairingLink("http://host:4096")).toBeUndefined()
+  } finally {
+    if (descriptor) Object.defineProperty(URL, "parse", descriptor)
+    else Reflect.deleteProperty(URL, "parse")
+  }
+})
