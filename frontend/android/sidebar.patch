+ * screen instead. The decision lives here so a bookmark, browser history, Android back, or a
+ * layout switch cannot render Home while vertical tabs are active.
+ */
+function HomeRoute() {
+  const settings = useSettings()
+  const vertical = useVerticalTabs()
+
+  return (
+    // Wait for the stored layout preference first: rendering Home while settings hydrate would
+    // flash it on every vertical-tabs start even though it is never the destination.
+    <Show when={settings.ready()} fallback={null}>
+      <Show when={!vertical()} fallback={<NewDraftHome />}>
+        <Home />
+      </Show>
+    </Show>
+  )
