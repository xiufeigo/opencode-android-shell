+        onClick={(event) => {
+          if (longPress.consumeClick(event)) return
+          props.onToggle()
+        }}
+        onPointerDown={longPress.pointerDown}
+        onPointerMove={longPress.pointerMove}
+        onPointerUp={longPress.pointerUp}
+        onPointerCancel={longPress.pointerCancel}
+      >
+        <Icon
+          name="chevron-down"
+          size="small"
+          class="shrink-0 text-v2-icon-icon-muted transition-transform duration-150 ease-in-out"
