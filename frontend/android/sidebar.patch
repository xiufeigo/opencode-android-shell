index 0000000..dad575a
--- /dev/null
+++ b/packages/app/src/home/sessions/actions.ts
@@ -0,0 +1,117 @@
+import type { SessionInfo } from "@opencode/client/promise"
+import type { QueryClient } from "@tanstack/solid-query"
+import { ServerConnection } from "@/runtime/server/registry"
+import type { ServerCtx } from "@/runtime/server/runtime"
+import type { useLanguage } from "@/runtime/i18n/language"
+import type { usePlatform } from "@/runtime/platform/platform"
+import { fetchSessionExport, saveSessionExport, sessionExportFilename } from "@/session/commands/export"
+import { sessionTreeIDs } from "@/session/requests/session-request-tree"
+import { sessionLabel } from "@/session/title"
+import { errorMessage } from "@/shell/layout/helpers"
+import { notifySessionTabsRemoved } from "@/shell/titlebar/session-events"
+import { showToast } from "@/shell/notifications/toast"
+
+type Language = ReturnType<typeof useLanguage>
+type Platform = ReturnType<typeof usePlatform>
+
+/**
+ * Session row actions shared by the home list and the project sidebar. Both surfaces render the
+ * same sessions, so rename/export/delete must update the same cache and remove the same tabs.
+ */
+export async function renameSessionRecord(input: {
+  ctx: ServerCtx
+  server: ServerConnection.Key
+  session: SessionInfo
+  title: string
+  queryClient: QueryClient
+  language: Language
+}) {
+  const next = input.title.trim()
+
+  if (!next || next === sessionLabel(input.session)) return true
+
+  return input.ctx.sdk.api.session
+    .update({ sessionID: input.session.id, title: next })
+    .then(() => {
+      input.ctx.data.session.remember({
+        ...(input.ctx.data.session.get(input.session.id) ?? input.session),
+        title: next,
+      })
+      // Rename advances time.updated server-side; re-sync the canonical record so date grouping
+      // and ordering do not go stale.
+      input.ctx.data.session.invalidate(input.session.id)
+      void input.ctx.data.session.sync(input.session.id).catch(() => {})
+      input.queryClient.setQueryData<SessionInfo[]>(["home-sessions", input.server], (current) =>
+        current?.map((item) => (item.id === input.session.id ? { ...item, title: next } : item)),
+      )
+
+      return true
+    })
+    .catch((cause) => {
+      showToast({
+        title: input.language.t("common.requestFailed"),
+        description: errorMessage(cause, input.language.t("common.requestFailed")),
+      })
+
+      return false
+    })
+}
+
+export async function exportSessionRecord(input: {
+  ctx: ServerCtx
+  session: SessionInfo
+  platform: Platform
+  language: Language
+}) {
+  try {
+    const data = await fetchSessionExport({ sessionID: input.session.id, api: input.ctx.sdk.api })
+    const filename = sessionExportFilename(data.info)
+
+    if (!(await saveSessionExport(filename, data, input.platform))) return
+    showToast({
+      variant: "success",
+      icon: "circle-check",
+      title: input.language.t("toast.session.export.success.title"),
+      description: input.language.t("toast.session.export.success.description", { filename }),
+    })
+  } catch (cause) {
+    showToast({
+      variant: "error",
+      title: input.language.t("toast.session.export.failed.title"),
+      description: cause instanceof Error ? cause.message : input.language.t("toast.session.export.failed.description"),
+    })
+  }
+}
+
+export async function removeSessionRecord(input: {
+  ctx: ServerCtx
+  server: ServerConnection.Key
+  session: SessionInfo
+  queryClient: QueryClient
+  language: Language
+}) {
+  const ids = sessionTreeIDs(input.ctx.data.session.list(), input.session.id)
+
+  return input.ctx.data.session
+    .remove(input.session.id)
+    .then(() => {
+      notifySessionTabsRemoved({
+        server: input.server,
+        directory: input.session.location.directory,
+        sessionIDs: ids,
+      })
+
+      return true
+    })
+    .catch((cause) => {
+      showToast({
+        title: input.language.t("session.delete.failed.title"),
+        description: errorMessage(cause, input.language.t("session.delete.failed.title")),
+      })
+
+      return false
+    })
+    .finally(() => {
+      void input.queryClient.invalidateQueries({ queryKey: ["home-sessions", input.server], exact: true })
+    })
+}
