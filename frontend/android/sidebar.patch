+  // Same query key and loader as the home page: both views share one cached
+  // index, and the session store covers live updates and pending removals.
+  const sessionLoad = useQuery(() => {
+    const current = ctx()
+    return {
+      queryKey: ["home-sessions", props.server] as const,
+      enabled: !!current && current.sdk.connection.status() === "connected",
+      queryFn: current
+        ? ({ signal }: { signal: AbortSignal }) =>
+            loadHomeSessionIndex((input, options) => current.sdk.api.session.list(input, options), signal)
+        : skipToken,
+      retry: false,
+      staleTime: 30_000,
+      refetchOnMount: true,
+    }
+  })
+
+  const sessions = createMemo(() => {
+    const current = ctx()
+    if (!current) return []
+    const fetched = sessionLoad.isPending ? [] : (sessionLoad.data ?? [])
+    return retainHomeSessions(
+      mergeHomeSessionIndex(fetched, current.data.session.list()),
+      HOME_SESSION_LIMIT,
+      Date.now(),
+    )
+  })
+
+  // Index every known child once per session-store update. Building it per row would scan the
+  // whole server session list again for each visible folder row.
+  const childSessions = createMemo(() => {
+    const current = ctx()
+    const index = new Map<string, SessionInfo[]>()
+    if (!current) return index
+    for (const session of current.data.session.list()) {
+      if (!session.parentID || typeof session.time.archived === "number") continue
+      const siblings = index.get(session.parentID)
+      if (siblings) siblings.push(session)
+      else index.set(session.parentID, [session])
+    }
+    for (const siblings of index.values()) siblings.sort(compareSessionTime)
+    return index
+  })
+
+  // Match the home page: only projects the user added or opened are part of this tree.
+  // Deriving rows from every session directory made never-opened projects appear here.
+  const projects = createMemo(() => ctx()?.projects.used() ?? [])
