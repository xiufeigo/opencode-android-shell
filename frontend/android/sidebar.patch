+    for (const project of projects()) entries.set(pathKey(project.worktree), { project, sessions: [] })
+    for (const session of sessions()) {
+      // Directory/sandbox membership only: a session from a directory the user never added
+      // must not attach to an unrelated project through a shared projectID.
+      const project = current.projects.forSession(session)
+      const entry = project ? entries.get(pathKey(project.worktree)) : undefined
+      if (entry) entry.sessions.push(session)
+    }
+    for (const entry of entries.values()) entry.sessions.sort(compareSessionTime)
+    return [...entries.values()]
+  })
