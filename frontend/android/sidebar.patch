+
+function ProjectRow(props: {
+  entry: ProjectEntry
+  expanded: boolean
+  count: number
+  onToggle: () => void
+  onNewSession: () => void
+  onImportSession: () => void
+  onEdit: () => void
+  onReveal: () => void
+  onClearNotifications: () => void
+  onClose: () => void
+  canImport: boolean
+  canReveal: boolean
+  unread: boolean
