+/**
+ * The vertical sidebar's navigation: settings and help. No Home row: vertical tabs replace Home
+ * with new drafts, and the brand wordmark above also opens one. Adding a project lives on the
+ * project tree's own header, next to the list it appends to.
+ */
+function VerticalSidebarNav() {
+  const language = useLanguage()
+  const command = useCommand()
+  const platform = usePlatform()
+
+  const row = (props: { action: string; icon: IconName; label: string; onClick: () => void }) => (
+    <button
+      type="button"
+      data-action={props.action}
+      class="flex h-7 w-full shrink-0 items-center gap-1.5 rounded-[6px] ps-1.5 pe-2 text-[13px] leading-4 text-v2-text-text-faint hover:text-v2-text-text-base focus-visible:outline-none focus-visible:bg-v2-background-bg-layer-02"
+      aria-label={props.label}
+      onClick={props.onClick}
+    >
+      <Icon name={props.icon} class="shrink-0" />
+      <span class="min-w-0 truncate">{props.label}</span>
+    </button>
+  )
+
+  return (
+    <div data-slot="vertical-sidebar-nav" class="flex shrink-0 flex-col gap-0.5">
+      {row({
+        action: "vertical-tabs-settings",
+        icon: "settings-gear",
+        label: language.t("sidebar.settings"),
+        onClick: () => void command.trigger("settings.open"),
+      })}
+      {row({
+        action: "vertical-tabs-help",
+        icon: "help",
+        label: language.t("sidebar.help"),
+        onClick: () => platform.openExternal("https://opencode.ai/docs"),
+      })}
+    </div>
+  )
+}
+
+/**
+ * The vertical sidebar's brand slot: the official OpenCode wordmark from `@opencode/ui/logo`.
+ * Its fills are theme tokens (--icon-weak-base / --icon-strong-base), so the wordmark is dark
+ * on light themes and light on dark themes without a separate per-theme asset. Vertical tabs
+ * have no Home surface, so clicking the wordmark opens a new draft like the row below it.
+ */
+function SidebarBrand() {
+  const language = useLanguage()
+  const command = useCommand()
+  const channel = import.meta.env.VITE_OPENCODE_CHANNEL
+
+  return (
+    <Tooltip
+      placement="right"
+      value={
+        channel && channel !== "prod" ? language.t(`titlebar.channel.${channel}`) : language.t("command.session.new")
+      }
+      class="mb-2 me-1 shrink-0 self-start"
+    >
+      <button
+        type="button"
+        data-slot="sidebar-brand"
+        data-action="vertical-tabs-brand"
+        class="flex h-10 w-full shrink-0 items-center rounded-[6px] ps-2 pe-2 [app-region:no-drag] hover:bg-v2-background-bg-layer-02 focus-visible:outline-none focus-visible:bg-v2-background-bg-layer-02"
+        aria-label={language.t("command.session.new")}
+        onClick={() => void command.trigger("tab.new")}
+      >
+        <Logo class="h-[30px] w-auto" />
+      </button>
+    </Tooltip>
+  )
+}
