+  // The panel is the transcript view, so it reads the whole history rather than the timeline's first page: the
+  // last `system` notice (system prompt) and older frames sit before that page. `loadMore(all)` drains every page
+  // and publishes once; the recent page stays on screen while it runs, and a failure keeps it with a reason.
+  const [history, setHistory] = createSignal<"idle" | "loading" | "done" | "failed">("idle")
+  const [historyError, setHistoryError] = createSignal<string>()
