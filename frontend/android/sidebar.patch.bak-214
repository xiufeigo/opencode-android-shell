+  // transcript refresh, so "still has older pages" can turn true again; the marker keeps that from draining twice,
+  // and the explicit retry is the only second attempt. No abort: the client's `loadMore` joins an in-flight read,
+  // and a settled cursor is itself the "already drained" mark, so a rebuilt panel does not re-read either.
+  let historySession: string | undefined
+  let historyTried: string | undefined
+
+  const loadHistory = (id: string) => {
+    if (historyTried === id) return
+    historyTried = id
+    setHistory("loading")
+    setHistoryError(undefined)
+    const store = props.session.server.data.session
+    void store.message
+      .loadMore(id, { all: true })
+      .then(() => setHistory("done"))
