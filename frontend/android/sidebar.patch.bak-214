diff --git a/packages/app/src/shell/titlebar/project-session-sidebar.tsx b/packages/app/src/shell/titlebar/project-session-sidebar.tsx
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/packages/app/src/shell/titlebar/project-session-sidebar.tsx
@@ -0,0 +1,1083 @@
+import type { SessionInfo } from "@opencode/client/promise"
+import { skipToken, useQuery, useQueryClient } from "@tanstack/solid-query"
+import { createEffect, createMemo, createSignal, For, onCleanup, Show, startTransition } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Icon } from "@opencode/ui/icon"
+import { IconButton } from "@opencode/ui/icon-button"
+import { InlineInput } from "@opencode/ui/inline-input"
+import { Menu } from "@opencode/ui/menu"
+import { displayName } from "@opencode/ui/project-avatar"
+import { Spinner } from "@opencode/ui/spinner"
+import { Tooltip } from "@opencode/ui/tooltip"
+import { useDialog } from "@opencode/ui/context/dialog"
+import {
+  HOME_SESSION_LIMIT,
+  loadHomeSessionIndex,
+  mergeHomeSessionIndex,
+  retainHomeSessions,
+} from "@/home/sessions/index"
+import { exportSessionRecord, removeSessionRecord, renameSessionRecord } from "@/home/sessions/actions"
+import { addProjects } from "@/home/projects/add"
+import { fileManagerApp } from "@/home/projects/file-manager"
+import { importSessionIntoProject } from "@/home/projects/import-session"
+import { useRevealProject } from "@/home/projects/reveal"
+import { useLanguage } from "@/runtime/i18n/language"
+import { usePlatform } from "@/runtime/platform/platform"
+import { serverName, ServerConnection, useServers } from "@/runtime/server/registry"
+import { useGlobal, useServerCtx } from "@/runtime/server/runtime"
+import { useDirectoryPicker } from "@/workspaces/selection/picker"
+import { useCommand } from "@/shell/commands/command"
+import { createDraftComposerState } from "@/composer/state"
+import { closeHomeProject, compareSessionTime, homeProjectDirectories } from "@/shell/layout/helpers"
+import { useLayout, type LocalProject } from "@/shell/state/layout"
+import { findSessionTab, tabKey, useTabs, type DraftTab, type SessionTab } from "@/shell/tabs/tabs"
+import { DeleteSessionDialog } from "@/session/delete-session-dialog"
+import { sessionLabel, sessionTitle } from "@/session/title"
+import { useSettingsSurface } from "@/settings/surface"
+import { pathKey } from "@/workspaces/path-key"
+
+const LONG_PRESS_MS = 500
+const LONG_PRESS_SLOP = 8
+const SESSION_PREVIEW_LIMIT = 5
+
+/**
+ * Unsent drafts belong to the "new session" action, not to a project: a draft has no session yet,
+ * so filing it under a worktree reads as an existing session in that project. This section sits
+ * directly below the sidebar's new-session row, above the project tree.
+ */
+export function DraftList() {
+  const language = useLanguage()
+  const tabs = useTabs()
+  const layout = useLayout()
+  const servers = useServers()
+
+  const drafts = createMemo(() => {
+    const visible = new Set(servers.visible.map((server) => ServerConnection.key(server)))
+    return tabs.store.filter((tab): tab is DraftTab => tab.type === "draft" && visible.has(tab.server))
+  })
+
+  const activeDraftID = createMemo(() => {
+    const route = layout.route()
+    return route.type === "draft" ? route.draftID : undefined
+  })
+
+  const close = (tab: DraftTab) => {
+    const index = tabs.store.findIndex((item) => tabKey(item) === tabKey(tab))
+    if (index !== -1) tabs.closeTab(index)
+  }
+
+  return (
+    <Show when={drafts().length > 0}>
+      <div
+        data-slot="draft-list"
+        class="flex max-h-56 min-w-0 shrink-0 flex-col gap-px overflow-y-auto py-0.5"
+        aria-label={language.t("command.session.new")}
+      >
+        <For each={drafts()}>
+          {(tab) => (
+            <DraftRow
+              tab={tab}
+              active={activeDraftID() === tab.draftID}
+              onOpen={() => tabs.select(tab)}
+              onClose={() => close(tab)}
+            />
+          )}
+        </For>
+      </div>
+    </Show>
+  )
+}
+
+function DraftRow(props: { tab: DraftTab; active: boolean; onOpen: () => void; onClose: () => void }) {
+  const language = useLanguage()
+  const tabs = useTabs()
+  const composer = tabs.state(props.tab, "prompt", () => createDraftComposerState(props.tab.draftID))
+
+  // The draft has no server session title yet, so show the text the user typed; an untouched draft
+  // keeps the same label as the action that created it.
+  const title = createMemo(
+    () =>
+      composer
+        .current()
+        .flatMap((part) => (part.type === "text" ? [part.content] : []))
+        .join("")
+        .trim() || language.t("command.session.new"),
+  )
+
+  return (
+    <div
+      data-slot="draft-row"
+      data-draft={props.tab.draftID}
+      data-active={props.active ? "" : undefined}
+      class="group/draft relative flex h-7 min-w-0 items-center rounded-[6px]"
+      classList={{ "bg-v2-overlay-simple-overlay-pressed": props.active }}
+    >
+      <button
+        type="button"
+        data-action="draft-open"
+        class={`
+          flex h-7 min-w-0 flex-1 items-center gap-2 rounded-[6px] ps-1.5 pe-6 text-start text-[13px] leading-4
+          text-v2-text-text-muted transition-[background-color,color] duration-[120ms] ease-in-out
+          hover:bg-v2-overlay-simple-overlay-hover hover:text-v2-text-text-base
+          focus-visible:bg-v2-overlay-simple-overlay-hover focus-visible:text-v2-text-text-base focus-visible:outline-none
+        `}
+        classList={{ "text-v2-text-text-base": props.active }}
+        onClick={props.onOpen}
+      >
+        <span class="flex size-4 shrink-0 items-center justify-center">
+          <Icon name="edit" />
+        </span>
+        <span class="min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap" dir="auto">
+          {title()}
+        </span>
+      </button>
+      <IconButton
+        data-action="draft-close"
+        variant="ghost-muted"
+        size="small"
+        class="absolute end-0.5 top-1/2 -translate-y-1/2"
+        onPointerDown={(event) => {
+          event.preventDefault()
+          event.stopPropagation()
+        }}
+        onClick={(event) => {
+          event.preventDefault()
+          event.stopPropagation()
+          props.onClose()
+        }}
+        icon={<Icon name="xmark-small" />}
+        aria-label={language.t("common.closeTab")}
+      />
+    </div>
+  )
+}
+
+/**
+ * Vertical-tabs sidebar: a project tree with the project's sessions instead of a
+ * flat list of open tabs. Projects come from the same per-server registry the
+ * home page renders; sessions come from the same index the home page loads, so
+ * both views agree and no protocol change is required.
+ */
+/** Server picker above the new-session row. The project tree shows only this server. */
+export function ServerSwitcher() {
+  const language = useLanguage()
+  const servers = useServers()
+  const layout = useLayout()
+
+  const current = createMemo(
+    () => servers.visible.find((server) => ServerConnection.key(server) === layout.home.selection().server) ?? servers.visible[0],
+  )
+
+  return (
+    <Show when={servers.visible.length > 1}>
+      <Menu gutter={6} modal={false} placement="bottom-start">
+        <Menu.Trigger
+          as="button"
+          type="button"
+          data-action="vertical-server-switch"
+          class="group flex h-7 w-full shrink-0 items-center justify-start gap-1.5 rounded-[6px] ps-1.5 pe-2 text-start text-[13px] leading-4 text-v2-text-text-faint hover:text-v2-text-text-base focus-visible:bg-v2-background-bg-layer-02 focus-visible:outline-none"
+          aria-label={language.t("sidebar.server.select")}
+        >
+          <Icon name="server" size="small" class="shrink-0 text-v2-icon-icon-muted" />
+          <span class="min-w-0 flex-1 truncate" dir="auto">
+            {serverName(current())}
+          </span>
+          <Icon name="chevron-down" size="small" class="shrink-0" />
+        </Menu.Trigger>
+        <Menu.Portal>
+          <Menu.Content class="max-h-[66.667dvh] w-56 max-w-56 overflow-y-auto">
+            <For each={servers.visible}>
+              {(server) => (
+                <Menu.Item
+                  data-action="vertical-server-option"
+                  class="text-start"
+                  onSelect={() => layout.home.setSelection({ server: ServerConnection.key(server) })}
+                >
+                  <span class="min-w-0 flex-1 truncate" dir="auto">
+                    {serverName(server)}
+                  </span>
+                  <Show when={ServerConnection.key(server) === ServerConnection.key(current())}>
+                    <Icon name="check-small" size="small" class="shrink-0 text-v2-icon-icon-accent" />
+                  </Show>
+                </Menu.Item>
+              )}
+            </For>
+          </Menu.Content>
+        </Menu.Portal>
+      </Menu>
+    </Show>
+  )
+}
+
+export function ProjectSessionSidebar() {
+  const language = useLanguage()
+  const servers = useServers()
+  const layout = useLayout()
+  const global = useGlobal()
+  const pickDirectory = useDirectoryPicker()
+
+  const server = createMemo(
+    () => servers.visible.find((item) => ServerConnection.key(item) === layout.home.selection().server) ?? servers.visible[0],
+  )
+
+  const addProject = () => {
+    const current = server()
+
+    if (!current) return
+    const context = global.ensureServerCtx(current)
+
+    pickDirectory({
+      server: current,
+      title: language.t("command.project.open"),
+      multiple: true,
+      onSelect: (result) => addProjects(context, homeProjectDirectories(result)),
+    })
+  }
+
+  return (
+    <div data-slot="project-sidebar" class="flex min-h-0 flex-1 flex-col">
+      <div class="flex h-6 shrink-0 items-center justify-between ps-1.5 pe-0.5 text-[11px] leading-4 text-v2-text-text-faint">
+        <span class="[font-weight:530]">{language.t("home.projects")}</span>
+        <Tooltip placement="bottom" value={language.t("home.project.add")}>
+          <IconButton
+            data-action="project-sidebar-add"
+            variant="ghost-muted"
+            size="small"
+            icon={<Icon name="plus" />}
+            aria-label={language.t("home.project.add")}
+            onClick={addProject}
+          />
+        </Tooltip>
+      </div>
+      <div
+        data-slot="project-sidebar-scroll"
+        class="flex min-h-0 flex-1 flex-col overflow-y-auto overflow-x-hidden pb-2"
+      >
+        <Show when={server()}>{(current) => <ServerProjectTree server={current()} />}</Show>
+      </div>
+    </div>
+  )
+}
+
+type ProjectEntry = {
+  project: LocalProject
+  sessions: SessionInfo[]
+}
+
+function ServerProjectTree(props: { server: ServerConnection.Any }) {
+  const language = useLanguage()
+  const tabs = useTabs()
+  const command = useCommand()
+  const layout = useLayout()
+  const platform = usePlatform()
+  const settings = useSettingsSurface()
+  const reveal = useRevealProject()
+  const dialog = useDialog()
+  const queryClient = useQueryClient()
+  const ctx = useServerCtx(() => props.server)
+  const [expanded, setExpanded] = createStore<Record<string, boolean>>({})
+  const [showAllSessions, setShowAllSessions] = createStore<Record<string, boolean>>({})
+  const serverKey = () => ServerConnection.key(props.server)
+  const active = createMemo(() => {
+    const route = layout.route()
+    return route.type === "session" ? { server: route.server, sessionId: route.sessionId } : undefined
+  })
+
+  // Same query key and loader as the home page: both views share one cached
+  // index, and the session store covers live updates and pending removals.
+  const sessionLoad = useQuery(() => {
+    const current = ctx()
+    return {
+      queryKey: ["home-sessions", props.server] as const,
+      enabled: !!current && current.sdk.connection.status() === "connected",
+      queryFn: current
+        ? ({ signal }: { signal: AbortSignal }) =>
+            loadHomeSessionIndex((input, options) => current.sdk.api.session.list(input, options), signal)
+        : skipToken,
+      retry: false,
+      staleTime: 30_000,
+      refetchOnMount: true,
+    }
+  })
+
+  const sessions = createMemo(() => {
+    const current = ctx()
+    if (!current) return []
+    const fetched = sessionLoad.isPending ? [] : (sessionLoad.data ?? [])
+    return retainHomeSessions(
+      mergeHomeSessionIndex(fetched, current.data.session.list()),
+      HOME_SESSION_LIMIT,
+      Date.now(),
+    )
+  })
+
+  // Index every known child once per session-store update. Building it per row would scan the
+  // whole server session list again for each visible folder row.
+  const childSessions = createMemo(() => {
+    const current = ctx()
+    const index = new Map<string, SessionInfo[]>()
+    if (!current) return index
+    for (const session of current.data.session.list()) {
+      if (!session.parentID || typeof session.time.archived === "number") continue
+      const siblings = index.get(session.parentID)
+      if (siblings) siblings.push(session)
+      else index.set(session.parentID, [session])
+    }
+    for (const siblings of index.values()) siblings.sort(compareSessionTime)
+    return index
+  })
+
+  // Match the home page: only projects the user added or opened are part of this tree.
+  // Deriving rows from every session directory made never-opened projects appear here.
+  const projects = createMemo(() => ctx()?.projects.list() ?? [])
+
+  const groups = createMemo(() => {
+    const current = ctx()
+    if (!current) return []
+    const entries = new Map<string, ProjectEntry>()
+    for (const project of projects()) entries.set(pathKey(project.worktree), { project, sessions: [] })
+    for (const session of sessions()) {
+      // Directory/sandbox membership only: a session from a directory the user never added
+      // must not attach to an unrelated project through a shared projectID.
+      const project = current.projects.forSession(session)
+      const entry = project ? entries.get(pathKey(project.worktree)) : undefined
+      if (entry) entry.sessions.push(session)
+    }
+    for (const entry of entries.values()) entry.sessions.sort(compareSessionTime)
+    return [...entries.values()]
+  })
+
+  const groupKey = (entry: ProjectEntry) => pathKey(entry.project.worktree)
+  const isExpanded = (entry: ProjectEntry) => {
+    const value = expanded[groupKey(entry)]
+    if (value !== undefined) return value
+    const route = active()
+    if (route?.server === serverKey() && entry.sessions.some((session) => session.id === route.sessionId)) return true
+    return entry.sessions.some((session) => !!findSessionTab(tabs.store, serverKey(), session.id))
+  }
+  const toggle = (entry: ProjectEntry) => {
+    const next = !isExpanded(entry)
+    setExpanded(groupKey(entry), next)
+    // Collapsing the folder returns it to the default five-session preview.
+    if (!next) setShowAllSessions(groupKey(entry), false)
+  }
+
+  // Opening a session from the home page or a command palette can target a row older than the
+  // preview. Reveal it instead of hiding the active session behind "show more".
+  createEffect(() => {
+    const route = active()
+    if (!route || route.server !== serverKey()) return
+    for (const entry of groups()) {
+      const index = entry.sessions.findIndex((session) => session.id === route.sessionId)
+      if (index >= SESSION_PREVIEW_LIMIT) setShowAllSessions(groupKey(entry), true)
+    }
+  })
+
+  const closeTab = (tab: SessionTab) => {
+    const index = tabs.store.findIndex((item) => tabKey(item) === tabKey(tab))
+    if (index !== -1) tabs.closeTab(index)
+  }
+
+  const openSession = (session: SessionInfo) => {
+    const current = ctx()
+    const existing = findSessionTab(tabs.store, serverKey(), session.id)
+    if (existing) {
+      tabs.select(existing)
+      return
+    }
+    void startTransition(() => {
+      const tab = tabs.addSessionTab({ server: serverKey(), sessionId: session.id })
+      tabs.select(tab)
+      current?.data.session.remember(session)
+      current?.projects.open(session.location.directory)
+      current?.projects.touch(session.location.directory)
+    })
+  }
+
+  const isSessionOpen = (session: SessionInfo) => !!findSessionTab(tabs.store, serverKey(), session.id)
+  const closeSession = (session: SessionInfo) => {
+    const tab = findSessionTab(tabs.store, serverKey(), session.id)
+    if (tab?.type === "session") closeTab(tab)
+  }
+
+  const newSession = (entry: ProjectEntry) => {
+    const current = ctx()
+    current?.projects.open(entry.project.worktree)
+    current?.projects.touch(entry.project.worktree)
+    void tabs.newDraft({ server: serverKey(), directory: entry.project.worktree })
+  }
+
+  const importSession = (entry: ProjectEntry) => {
+    const current = ctx()
+    if (!current) return
+    void importSessionIntoProject({
+      ctx: current,
+      directory: entry.project.worktree,
+      platform,
+      language,
+      onImported: openSession,
+    })
+  }
+
+  const editProject = (entry: ProjectEntry) =>
+    settings.openProject({ server: serverKey(), project: entry.project.worktree })
+
+  const directories = (entry: ProjectEntry) => [entry.project.worktree, ...(entry.project.sandboxes ?? [])]
+
+  const hasUnread = (entry: ProjectEntry) => {
+    const current = ctx()
+    if (!current) return false
+    return directories(entry).some((directory) => current.notification.project.hasUnread(directory))
+  }
+
+  const clearNotifications = (entry: ProjectEntry) => {
+    const current = ctx()
+    if (!current) return
+    directories(entry).forEach((directory) => current.notification.project.markViewed(directory))
+  }
+
+  const closeProject = (entry: ProjectEntry) => {
+    const current = ctx()
+    if (!current) return
+    const next = closeHomeProject(layout.home.selection(), serverKey(), current.projects, entry.project.worktree)
+    if (next) layout.home.setSelection(next)
+  }
+
+  const renameSession = async (session: SessionInfo, title: string) => {
+    const current = ctx()
+    if (!current) return false
+    return renameSessionRecord({
+      ctx: current,
+      server: serverKey(),
+      session,
+      title,
+      queryClient,
+      language,
+    })
+  }
+
+  const exportSession = (session: SessionInfo) => {
+    const current = ctx()
+    if (!current) return
+    void exportSessionRecord({ ctx: current, session, platform, language })
+  }
+
+  const deleteSession = (session: SessionInfo) => {
+    const current = ctx()
+    if (!current) return
+    void dialog.show(() => (
+      <DeleteSessionDialog
+        name={sessionTitle(session.title) ?? language.t("command.session.new")}
+        onConfirm={() =>
+          removeSessionRecord({ ctx: current, server: serverKey(), session, queryClient, language })
+        }
+      />
+    ))
+  }
+
+  const visibleTabs = createMemo(() => {
+    const ordered: SessionTab[] = []
+    for (const entry of groups()) {
+      for (const session of entry.sessions) {
+        const tab = findSessionTab(tabs.store, serverKey(), session.id)
+        if (tab?.type === "session") ordered.push(tab)
+      }
+    }
+    return ordered
+  })
+
+  const cycle = (offset: -1 | 1) => {
+    const list = visibleTabs()
+    if (list.length === 0) return
+    const route = active()
+    const current = route ? findSessionTab(tabs.store, route.server, route.sessionId) : undefined
+    const index = current ? list.findIndex((tab) => tabKey(tab) === tabKey(current)) : -1
+    tabs.select(list[(index + offset + list.length) % list.length]!)
+  }
+
+  command.register("project-sidebar-tab-cycle", () => [
+    {
+      id: "tab.prev",
+      category: "tab",
+      title: "",
+      keybind: `mod+option+ArrowLeft,ctrl+shift+tab`,
+      hidden: true,
+      onSelect: () => cycle(-1),
+    },
+    {
+      id: "tab.next",
+      category: "tab",
+      title: "",
+      keybind: `mod+option+ArrowRight,ctrl+tab`,
+      hidden: true,
+      onSelect: () => cycle(1),
+    },
+  ])
+  command.register("project-sidebar-tab-numbers", () =>
+    visibleTabs()
+      .slice(0, 9)
+      .map((tab, index) => ({
+        id: `tab.${index + 1}`,
+        category: "tab",
+        title: "",
+        keybind: `mod+${index + 1}`,
+        hidden: true,
+        onSelect: () => tabs.select(tab),
+      })),
+  )
+
+  return (
+    <div class="flex min-w-0 flex-col" data-server={serverKey()}>
+      <For each={groups()}>
+        {(entry) => {
+          const count = () => entry.sessions.length
+          const hiddenCount = () => Math.max(0, count() - SESSION_PREVIEW_LIMIT)
+          const allShown = () => !!showAllSessions[groupKey(entry)]
+          const visibleSessions = () => (allShown() ? entry.sessions : entry.sessions.slice(0, SESSION_PREVIEW_LIMIT))
+          const activeSessionID = () => (active()?.server === serverKey() ? active()?.sessionId : undefined)
+          return (
+            <div class="flex min-w-0 flex-col" data-slot="project-group">
+              <ProjectRow
+                entry={entry}
+                expanded={isExpanded(entry)}
+                count={count()}
+                onToggle={() => toggle(entry)}
+                onNewSession={() => newSession(entry)}
+                onImportSession={() => importSession(entry)}
+                onEdit={() => editProject(entry)}
+                onClearNotifications={() => clearNotifications(entry)}
+                onClose={() => closeProject(entry)}
+                canImport={!!platform.openAttachmentPickerDialog}
+                canReveal={reveal.available(props.server)}
+                onReveal={() => reveal.reveal(props.server, entry.project)}
+                unread={hasUnread(entry)}
+                revealLabel={fileManagerApp(
+                  platform.platform === "desktop" ? (platform.os ?? "unknown") : "unknown",
+                ).actionLabel}
+              />
+              <Show when={isExpanded(entry)}>
+                <div class="flex min-w-0 flex-col gap-px pb-1" data-slot="project-sessions">
+                  <For each={visibleSessions()}>
+                    {(session) => (
+                      <SessionGroup
+                        server={props.server}
+                        session={session}
+                        children={() => childSessions().get(session.id) ?? []}
+                        activeSessionID={activeSessionID()}
+                        isOpen={isSessionOpen}
+                        onOpen={openSession}
+                        onClose={closeSession}
+                        onRename={renameSession}
+                        onExport={exportSession}
+                        onDelete={deleteSession}
+                      />
+                    )}
+                  </For>
+                  <Show when={hiddenCount() > 0}>
+                    <button
+                      type="button"
+                      data-action="project-sessions-toggle"
+                      data-expanded={allShown() ? "" : undefined}
+                      class={`
+                        flex h-7 min-w-0 items-center rounded-[6px] ps-[46px] pe-2 text-start text-[12px] leading-4
+                        text-v2-text-text-faint transition-[background-color,color] duration-[120ms] ease-in-out
+                        hover:bg-v2-overlay-simple-overlay-hover hover:text-v2-text-text-base
+                        focus-visible:bg-v2-overlay-simple-overlay-hover focus-visible:text-v2-text-text-base focus-visible:outline-none
+                      `}
+                      onClick={() => setShowAllSessions(groupKey(entry), !allShown())}
+                    >
+                      {allShown()
+                        ? language.t("sidebar.sessions.collapse")
+                        : language.plural("sidebar.sessions.more", hiddenCount())}
+                    </button>
+                  </Show>
+                </div>
+              </Show>
+            </div>
+          )
+        }}
+      </For>
+      <Show when={sessionLoad.isPending && groups().length === 0}>
+        <div class="flex h-7 items-center justify-center">
+          <Spinner class="size-3.5" />
+        </div>
+      </Show>
+      <Show when={!sessionLoad.isPending && groups().length === 0}>
+        <div class="px-1.5 py-1 text-[11px] leading-4 text-v2-text-text-faint">{language.t("sidebar.empty.title")}</div>
+      </Show>
+    </div>
+  )
+}
+
+/**
+ * Folder glyph for project rows. The path inherits `currentColor`, so the sidebar theme decides
+ * whether it renders dark or light without a second asset.
+ */
+function FolderIcon(props: { class?: string }) {
+  return (
+    <svg viewBox="0 0 1024 1024" class={props.class} fill="currentColor" aria-hidden="true">
+      <path d="M855.04 385.024q19.456 2.048 38.912 10.24t33.792 23.04 21.504 37.376 2.048 54.272q-2.048 8.192-8.192 40.448t-14.336 74.24-18.432 86.528-19.456 76.288q-5.12 18.432-14.848 37.888t-25.088 35.328-36.864 26.112-51.2 10.24l-567.296 0q-21.504 0-44.544-9.216t-42.496-26.112-31.744-40.96-12.288-53.76l0-439.296q0-62.464 33.792-97.792t95.232-35.328l503.808 0q22.528 0 46.592 8.704t43.52 24.064 31.744 35.84 12.288 44.032l0 11.264-53.248 0q-40.96 0-95.744-0.512t-116.736-0.512-115.712-0.512-92.672-0.512l-47.104 0q-26.624 0-41.472 16.896t-23.04 44.544q-8.192 29.696-18.432 62.976t-18.432 61.952q-10.24 33.792-20.48 65.536-2.048 8.192-2.048 13.312 0 17.408 11.776 29.184t29.184 11.776q31.744 0 43.008-39.936l54.272-198.656q133.12 1.024 243.712 1.024l286.72 0z" />
+    </svg>
+  )
+}
+
+function ProjectRow(props: {
+  entry: ProjectEntry
+  expanded: boolean
+  count: number
+  onToggle: () => void
+  onNewSession: () => void
+  onImportSession: () => void
+  onEdit: () => void
+  onReveal: () => void
+  onClearNotifications: () => void
+  onClose: () => void
+  canImport: boolean
+  canReveal: boolean
+  unread: boolean
+  revealLabel: string
+}) {
+  const language = useLanguage()
+  const [open, setOpen] = createSignal(false)
+  const longPress = createLongPress(() => setOpen(true))
+  return (
+    <div
+      data-slot="project-row"
+      data-project={props.entry.project.worktree}
+      data-expanded={props.expanded ? "" : undefined}
+      class="group/project relative flex h-7 min-w-0 shrink-0 items-center rounded-[6px]"
+      onContextMenu={(event) => {
+        event.preventDefault()
+        setOpen(true)
+      }}
+    >
+      <button
+        type="button"
+        aria-expanded={props.expanded}
+        class={`
+          flex h-7 min-w-0 flex-1 items-center gap-1.5 rounded-[6px] ps-1 pe-16 text-start
+          text-[13px] leading-4 text-v2-text-text-muted transition-[background-color,color] duration-[120ms] ease-in-out
+          hover:bg-v2-overlay-simple-overlay-hover hover:text-v2-text-text-base
+          focus-visible:bg-v2-overlay-simple-overlay-hover focus-visible:text-v2-text-text-base focus-visible:outline-none
+        `}
+        onClick={(event) => {
+          if (longPress.consumeClick(event)) return
+          props.onToggle()
+        }}
+        onPointerDown={longPress.pointerDown}
+        onPointerMove={longPress.pointerMove}
+        onPointerUp={longPress.pointerUp}
+        onPointerCancel={longPress.pointerCancel}
+      >
+        <Icon
+          name="chevron-down"
+          size="small"
+          class="shrink-0 text-v2-icon-icon-muted transition-transform duration-150 ease-in-out"
+          style={{ transform: props.expanded ? "rotate(0deg)" : "rotate(-90deg)" }}
+        />
+        <FolderIcon class="size-4 shrink-0 text-v2-icon-icon-muted" />
+        <span data-slot="project-title" class="min-w-0 flex-1 truncate [font-weight:530]" dir="auto">
+          {displayName(props.entry.project)}
+        </span>
+        <Show when={props.count > 0}>
+          <span class="shrink-0 pe-0.5 text-[11px] tabular-nums text-v2-text-text-faint">{props.count}</span>
+        </Show>
+      </button>
+      <div
+        data-slot="project-row-actions"
+        data-menu={open()}
+        class="hover-reveal group-hover/project:opacity-100 focus-within:opacity-100 data-[menu=true]:opacity-100 absolute end-0.5 top-0 flex h-7 items-center gap-0.5"
+      >
+        <Menu
+          gutter={6}
+          modal={false}
+          placement="bottom-end"
+          open={open()}
+          onOpenChange={setOpen}
+        >
+          <Menu.Trigger
+            as={IconButton}
+            data-action="project-sidebar-menu"
+            variant="ghost-muted"
+            size="small"
+            icon={<Icon name="outline-dots" />}
+            aria-label={language.t("common.moreOptions")}
+          />
+          <Menu.Portal>
+            <Menu.Content>
+              <Menu.Item onSelect={props.onNewSession}>{language.t("command.session.new")}</Menu.Item>
+              <Show when={props.canImport}>
+                <Menu.Item onSelect={props.onImportSession}>{language.t("command.session.import")}</Menu.Item>
+              </Show>
+              <Menu.Item onSelect={props.onEdit}>{language.t("dialog.project.edit.title")}</Menu.Item>
+              <Show when={props.canReveal}>
+                <Menu.Item onSelect={props.onReveal}>{props.revealLabel}</Menu.Item>
+              </Show>
+              <Menu.Item disabled={!props.unread} onSelect={props.onClearNotifications}>
+                {language.t("sidebar.project.clearNotifications")}
+              </Menu.Item>
+              <Menu.Separator />
+              <Menu.Item onSelect={props.onClose}>{language.t("common.close")}</Menu.Item>
+            </Menu.Content>
+          </Menu.Portal>
+        </Menu>
+        <Tooltip placement="right" value={language.t("command.session.new")}>
+          <IconButton
+            data-action="project-sidebar-new-session"
+            variant="ghost-muted"
+            size="small"
+            icon={<Icon name="edit" />}
+            aria-label={language.t("command.session.new")}
+            onClick={props.onNewSession}
+          />
+        </Tooltip>
+      </div>
+    </div>
+  )
+}
+
+type SessionActions = {
+  onOpen: (session: SessionInfo) => void
+  onClose: (session: SessionInfo) => void
+  onRename: (session: SessionInfo, title: string) => Promise<boolean>
+  onExport: (session: SessionInfo) => void
+  onDelete: (session: SessionInfo) => void
+}
+
+/**
+ * One root session plus its direct subagent sessions. The row's family is synced when it mounts
+ * so the expander appears for historical roots too, not only for subagents created in this window.
+ */
+function SessionGroup(props: {
+  server: ServerConnection.Any
+  session: SessionInfo
+  children: () => SessionInfo[]
+  activeSessionID?: string
+  isOpen: (session: SessionInfo) => boolean
+  onOpen: (session: SessionInfo) => void
+  onClose: (session: SessionInfo) => void
+  onRename: (session: SessionInfo, title: string) => Promise<boolean>
+  onExport: (session: SessionInfo) => void
+  onDelete: (session: SessionInfo) => void
+}) {
+  const ctx = useServerCtx(() => props.server)
+  const [childrenExpanded, setChildrenExpanded] = createSignal(false)
+
+  createEffect(() => {
+    const current = ctx()
+    if (!current || current.sdk.connection.status() !== "connected") return
+    void Promise.allSettled([current.data.session.sync(props.session.id, { children: true })])
+  })
+
+  // Arriving from a subagent link should reveal the row that owns it.
+  createEffect(() => {
+    const active = props.activeSessionID
+    if (!active) return
+    if (props.children().some((session) => session.id === active)) setChildrenExpanded(true)
+  })
+
+  const actions: SessionActions = {
+    onOpen: props.onOpen,
+    onClose: props.onClose,
+    onRename: props.onRename,
+    onExport: props.onExport,
+    onDelete: props.onDelete,
+  }
+
+  return (
+    <>
+      <SessionRow
+        session={props.session}
+        title={sessionLabel(props.session)}
+        active={props.activeSessionID === props.session.id}
+        open={props.isOpen(props.session)}
+        hasChildren={props.children().length > 0}
+        childrenExpanded={childrenExpanded()}
+        onToggleChildren={() => setChildrenExpanded((value) => !value)}
+        {...actions}
+      />
+      <Show when={childrenExpanded()}>
+        <For each={props.children()}>
+          {(child) => (
+            <SessionRow
+              session={child}
+              title={sessionLabel(child)}
+              active={props.activeSessionID === child.id}
+              open={props.isOpen(child)}
+              depth={1}
+              {...actions}
+            />
+          )}
+        </For>
+      </Show>
+    </>
+  )
+}
+
+function SessionRow(props: {
+  session: SessionInfo
+  title: string
+  active: boolean
+  open: boolean
+  depth?: number
+  hasChildren?: boolean
+  childrenExpanded?: boolean
+  onToggleChildren?: () => void
+  onOpen: (session: SessionInfo) => void
+  onClose: (session: SessionInfo) => void
+  onRename: (session: SessionInfo, title: string) => Promise<boolean>
+  onExport: (session: SessionInfo) => void
+  onDelete: (session: SessionInfo) => void
+}) {
+  const language = useLanguage()
+  const [menu, setMenu] = createSignal<{ x: number; y: number }>()
+  const [editor, setEditor] = createSignal<{ draft: string; saving: boolean }>()
+  const [pendingRename, setPendingRename] = createSignal(false)
+  // Titles start on the folder name's first character (x=57 at a 260px sidebar); subagent rows step
+  // in once more so the folder > session > subagent hierarchy stays readable.
+  const indent = () => (props.depth ? "ps-[66px]" : "ps-[46px]")
+  // The children chevron centres on the folder icon (x=35..51), and its 28px box ends where the title
+  // starts, so it uses the folder-icon column plus the gap instead of shifting any title.
+  const expander = () => "start-[18px]"
+  let input: HTMLInputElement | undefined
+
+  const openMenu = (element: HTMLElement, x: number, y: number) => {
+    const bounds = element.getBoundingClientRect()
+    setMenu({ x: x - bounds.left, y: y - bounds.top })
+  }
+
+  const longPress = createLongPress((element, x, y) => openMenu(element, x, y))
+
+  onCleanup(() => setMenu(undefined))
+
+  const openEditor = () => {
+    setEditor({ draft: props.title, saving: false })
+    requestAnimationFrame(() => {
+      input?.focus()
+      input?.select()
+    })
+  }
+
+  const save = async () => {
+    const current = editor()
+    if (!current || current.saving) return
+    setEditor({ ...current, saving: true })
+    if (await props.onRename(props.session, current.draft)) setEditor(undefined)
+    else setEditor((value) => (value ? { ...value, saving: false } : value))
+  }
+
+  return (
+    <div
+      data-slot="session-row"
+      data-session={props.session.id}
+      data-active={props.active ? "" : undefined}
+      class="group/session relative flex h-7 min-w-0 items-center rounded-[6px]"
+      classList={{ "bg-v2-overlay-simple-overlay-pressed": props.active }}
+      onContextMenu={(event) => {
+        if (editor()) return
+        event.preventDefault()
+        openMenu(event.currentTarget, event.clientX, event.clientY)
+      }}
+    >
+      <Show
+        when={!editor()}
+        fallback={
+          <div class={`flex h-7 min-w-0 flex-1 items-center ${indent()} pe-6`}>
+            <InlineInput
+              ref={input}
+              data-slot="session-rename"
+              aria-label={language.t("common.rename")}
+              dir="auto"
+              value={editor()?.draft ?? ""}
+              disabled={editor()?.saving ?? false}
+              class="block min-w-0 flex-1 text-[13px] leading-4 text-v2-text-text-base [font-weight:530]"
+              style={{ "--inline-input-shadow": "none", "text-align": "start" }}
+              onInput={(event) => {
+                const draft = event.currentTarget.value
+                setEditor((value) => (value ? { ...value, draft } : value))
+              }}
+              onKeyDown={(event) => {
+                event.stopPropagation()
+                if (event.isComposing || event.keyCode === 229) return
+                if (event.key === "Enter") {
+                  event.preventDefault()
+                  void save()
+                  return
+                }
+                if (event.key === "Escape") {
+                  event.preventDefault()
+                  setEditor(undefined)
+                }
+              }}
+              onBlur={() => setEditor(undefined)}
+            />
+          </div>
+        }
+      >
+        <Show when={props.hasChildren}>
+          <button
+            type="button"
+            data-action="session-children-toggle"
+            aria-expanded={props.childrenExpanded ?? false}
+            aria-label={language.t(
+              props.childrenExpanded ? "sidebar.session.children.collapse" : "sidebar.session.children.expand",
+            )}
+            class={`
+              absolute ${expander()} top-1/2 z-10 flex size-7 -translate-y-1/2 items-center justify-center rounded-[4px]
+              text-v2-icon-icon-muted transition-colors duration-[120ms] ease-in-out
+              hover:bg-v2-overlay-simple-overlay-hover hover:text-v2-icon-icon-base focus-visible:outline-none
+            `}
+            onPointerDown={(event) => {
+              event.preventDefault()
+              event.stopPropagation()
+            }}
+            onClick={(event) => {
+              event.preventDefault()
+              event.stopPropagation()
+              props.onToggleChildren?.()
+            }}
+          >
+            <Icon
+              name="chevron-down"
+              size="small"
+              class="transition-transform duration-150 ease-in-out"
+              style={{ transform: props.childrenExpanded ? "rotate(0deg)" : "rotate(-90deg)" }}
+            />
+          </button>
+        </Show>
+        <button
+          type="button"
+          class={`
+            flex h-7 min-w-0 flex-1 items-center rounded-[6px] ${indent()} pe-6 text-start text-[13px] leading-4
+            text-v2-text-text-muted transition-[background-color,color] duration-[120ms] ease-in-out
+            hover:bg-v2-overlay-simple-overlay-hover hover:text-v2-text-text-base
+            focus-visible:bg-v2-overlay-simple-overlay-hover focus-visible:text-v2-text-text-base focus-visible:outline-none
+          `}
+          classList={{ "text-v2-text-text-base": props.active }}
+          onClick={(event) => {
+            if (longPress.consumeClick(event)) return
+            props.onOpen(props.session)
+          }}
+          onPointerDown={longPress.pointerDown}
+          onPointerMove={longPress.pointerMove}
+          onPointerUp={longPress.pointerUp}
+          onPointerCancel={longPress.pointerCancel}
+          onKeyDown={(event) => {
+            if (event.key !== "ContextMenu" && (event.key !== "F10" || !event.shiftKey)) return
+            event.preventDefault()
+            const bounds = event.currentTarget.getBoundingClientRect()
+            openMenu(event.currentTarget, bounds.left + 12, bounds.bottom)
+          }}
+        >
+          <span class="min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap" dir="auto">
+            {props.title}
+          </span>
+        </button>
+      </Show>
+      <Show when={props.open && !editor()}>
+        <IconButton
+          variant="ghost-muted"
+          size="small"
+          class="hover-reveal absolute end-0.5 top-1/2 -translate-y-1/2 group-hover/session:opacity-100 focus-within:opacity-100"
+          onPointerDown={(event) => {
+            event.preventDefault()
+            event.stopPropagation()
+          }}
+          onClick={(event) => {
+            event.preventDefault()
+            event.stopPropagation()
+            props.onClose(props.session)
+          }}
+          icon={<Icon name="xmark-small" />}
+          aria-label={language.t("common.closeTab")}
+        />
+      </Show>
+      <Menu
+        modal={false}
+        placement="bottom-start"
+        gutter={2}
+        open={!!menu()}
+        onOpenChange={(next) => {
+          if (!next) setMenu(undefined)
+        }}
+      >
+        <Menu.Trigger
+          as="span"
+          aria-hidden="true"
+          tabIndex={-1}
+          class="pointer-events-none absolute size-px"
+          style={{ left: `${menu()?.x ?? 0}px`, top: `${menu()?.y ?? 0}px` }}
+        />
+        <Menu.Portal>
+          <Menu.Content
+            onCloseAutoFocus={(event) => {
+              if (!pendingRename()) return
+              event.preventDefault()
+              setPendingRename(false)
+              openEditor()
+            }}
+          >
+            <Menu.Item data-action="session-rename" onSelect={() => setPendingRename(true)}>
+              {language.t("common.rename")}
+            </Menu.Item>
+            <Menu.Item onSelect={() => props.onExport(props.session)}>{language.t("common.export")}…</Menu.Item>
+            <Menu.Separator />
+            <Menu.Item onSelect={() => props.onDelete(props.session)}>{language.t("common.delete")}…</Menu.Item>
+          </Menu.Content>
+        </Menu.Portal>
+      </Menu>
+    </div>
+  )
+}
+
+/**
+ * Touch context menu: a 500ms press opens the row menu, while a drag of more than 8px cancels it.
+ * The click that follows the long press is swallowed so it cannot also open the session.
+ */
+function createLongPress(open: (element: HTMLElement, x: number, y: number) => void) {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let start: { x: number; y: number } | undefined
+  let suppress = false
+
+  const cancel = () => {
+    if (timer) clearTimeout(timer)
+    timer = undefined
+    start = undefined
+  }
+
+  onCleanup(cancel)
+
+  return {
+    pointerDown(event: PointerEvent) {
+      if (event.pointerType !== "touch") return
+      cancel()
+      const element = event.currentTarget as HTMLElement
+      const x = event.clientX
+      const y = event.clientY
+      start = { x, y }
+      timer = setTimeout(() => {
+        suppress = true
+        cancel()
+        open(element, x, y)
+      }, LONG_PRESS_MS)
+    },
+    pointerMove(event: PointerEvent) {
+      if (!start) return
+      if (Math.abs(event.clientX - start.x) <= LONG_PRESS_SLOP && Math.abs(event.clientY - start.y) <= LONG_PRESS_SLOP)
+        return
+      cancel()
+    },
+    pointerUp: cancel,
+    pointerCancel() {
+      cancel()
+      suppress = false
+    },
+    consumeClick(event: MouseEvent) {
+      if (!suppress) return false
+      suppress = false
+      if (event.detail === 0) return false
+      event.preventDefault()
+      return true
+    },
+  }
+}

diff --git a/packages/app/src/shell/titlebar/vertical-sidebar-toolbar.tsx b/packages/app/src/shell/titlebar/vertical-sidebar-toolbar.tsx
new file mode 100644
index 0000000..7a7b847
--- /dev/null
+++ b/packages/app/src/shell/titlebar/vertical-sidebar-toolbar.tsx
@@ -0,0 +1,106 @@
+import { Show } from "solid-js"
+import { Icon } from "@opencode/ui/icon"
+import { IconButton } from "@opencode/ui/icon-button"
+import { Tooltip } from "@opencode/ui/tooltip"
+import { useCommand } from "@/shell/commands/command"
+import { useLanguage } from "@/runtime/i18n/language"
+import { usePlatform } from "@/runtime/platform/platform"
+import { useLayout } from "@/shell/state/layout"
+import { WindowsAppMenu } from "./windows-menu"
+
+/**
+ * Small top-left control row for the vertical-tabs sidebar, matching the familiar
+ * (menu / collapse sidebar / back / forward) cluster. When the sidebar is collapsed the
+ * first two controls render inline in the session title row instead.
+ */
+export function VerticalSidebarToolbar(props: { class?: string }) {
+  const command = useCommand()
+  const platform = usePlatform()
+  const language = useLanguage()
+
+  return (
+    <div data-slot="vertical-sidebar-toolbar" class={`flex h-7 shrink-0 items-center gap-0.5 ${props.class ?? ""}`}>
+      <WindowsAppMenu
+        command={command}
+        platform={platform}
+        menuPlatform={platform.platform === "android" ? "android" : "windows"}
+        actionEnabled={platform.platform === "android" ? platform.androidMenuActionEnabled : undefined}
+      />
+      <SidebarCollapseButton />
+      <Tooltip placement="bottom" value={language.t("common.goBack")}>
+        <IconButton
+          data-action="vertical-sidebar-back"
+          variant="ghost-muted"
+          size="large"
+          icon={<Icon name="arrow-left" />}
+          aria-label={language.t("common.goBack")}
+          disabled={disabled(command, "common.goBack")}
+          onClick={() => void command.trigger("common.goBack")}
+        />
+      </Tooltip>
+      <Tooltip placement="bottom" value={language.t("common.goForward")}>
+        <IconButton
+          data-action="vertical-sidebar-forward"
+          variant="ghost-muted"
+          size="large"
+          icon={<Icon name="arrow-right" />}
+          aria-label={language.t("common.goForward")}
+          disabled={disabled(command, "common.goForward")}
+          onClick={() => void command.trigger("common.goForward")}
+        />
+      </Tooltip>
+    </div>
+  )
+}
+
+/**
+ * Collapsed-state controls. They sit before the session's project icon, so the session header
+ * itself remains the place where the sidebar is restored.
+ */
+export function CollapsedSidebarControls() {
+  const command = useCommand()
+  const platform = usePlatform()
+  const layout = useLayout()
+
+  return (
+    <Show when={layout.verticalTabs.collapsed()}>
+      <div
+        data-slot="collapsed-sidebar-controls"
+        class="flex shrink-0 items-center gap-0.5 border-e border-v2-border-border-muted pe-1 me-0.5"
+      >
+        <WindowsAppMenu
+          command={command}
+          platform={platform}
+          menuPlatform={platform.platform === "android" ? "android" : "windows"}
+          actionEnabled={platform.platform === "android" ? platform.androidMenuActionEnabled : undefined}
+        />
+        <SidebarCollapseButton />
+      </div>
+    </Show>
+  )
+}
+
+function SidebarCollapseButton() {
+  const layout = useLayout()
+  const language = useLanguage()
+  const collapsed = () => layout.verticalTabs.collapsed()
+  const label = () => language.t(collapsed() ? "sidebar.expand" : "sidebar.collapse")
+
+  return (
+    <Tooltip placement="bottom" value={label()}>
+      <IconButton
+        data-action="vertical-sidebar-collapse"
+        variant="ghost-muted"
+        size="large"
+        icon={<Icon name="layout-left" />}
+        aria-label={label()}
+        aria-expanded={!collapsed()}
+        onClick={() => layout.verticalTabs.toggleCollapsed()}
+      />
+    </Tooltip>
+  )
+}
+
+function disabled(command: ReturnType<typeof useCommand>, id: string) {
+  return !!command.options.find((option) => option.id === id)?.disabled
+}

