         object-fit: contain;
-        border-radius: var(--radius-md);
+        transform-origin: center;
+        /* Only the gesture drives the transform, so no transition fights the pinch. */
+        transition: none;
+        will-change: transform;
+        user-select: none;
+        -webkit-user-drag: none;
       }
     }
