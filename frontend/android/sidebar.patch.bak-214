+  // Drain once per session, as soon as its first page is in the store and older pages remain. `messageLoading`
+  // belongs to the timeline's own paging, so it is deliberately not a trigger. The session-change reset happens in
+  // this same run, before the drain decision, so the two can never race into a second read.
+  createEffect(
+    on(
+      () => {
+        const id = props.session.id
+        if (!id) return
+        const store = props.session.server.data.session
+        return [id, store.message.list(id).length > 0, store.message.more(id)] as const
+      },
+      (value) => {
+        if (!value) return
+        const [id, ready, more] = value
+        if (historySession !== id) {
+          historySession = id
+          historyTried = undefined
+          setHistoryError(undefined)
