diff --git a/packages/app/src/session/delete-session-dialog.tsx b/packages/app/src/session/delete-session-dialog.tsx
new file mode 100644
index 0000000..6144a87
--- /dev/null
+++ b/packages/app/src/session/delete-session-dialog.tsx
@@ -0,0 +1,36 @@
+import { Button } from "@opencode/ui/button"
+import { Dialog, DialogFooter, DialogHeader, DialogTitleGroup } from "@opencode/ui/dialog"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { useLanguage } from "@/runtime/i18n/language"
+
+/**
+ * Confirmation shared by the home session list and the project sidebar. The caller owns the
+ * delete request and returns whether it succeeded so the dialog stays open after a failure.
+ */
+export function DeleteSessionDialog(props: { name: string; onConfirm: () => Promise<boolean> }) {
+  const dialog = useDialog()
+  const language = useLanguage()
+
+  const confirm = async () => {
+    if (await props.onConfirm()) dialog.close()
+  }
+
+  return (
+    <Dialog fit>
+      <DialogHeader hideClose>
+        <DialogTitleGroup
+          title={language.t("session.delete.title")}
+          description={language.t("session.delete.confirm", { name: props.name })}
+        />
+      </DialogHeader>
+      <DialogFooter>
+        <Button variant="ghost" onClick={() => dialog.close()}>
+          {language.t("common.cancel")}
+        </Button>
+        <Button variant="danger" onClick={confirm}>
+          {language.t("session.delete.button")}
+        </Button>
+      </DialogFooter>
+    </Dialog>
+  )
+}

