diff --git a/packages/ui/src/components/image-preview.tsx b/packages/ui/src/components/image-preview.tsx
index 7eda4d0..6cf1d6a 100644
--- a/packages/ui/src/components/image-preview.tsx
+++ b/packages/ui/src/components/image-preview.tsx
@@ -1,21 +1,287 @@
 import { Dialog as Kobalte } from "@kobalte/core/dialog"
+import { createSignal, onCleanup, onMount, Show } from "solid-js"
 import { useI18n } from "../context/i18n"
 import { Icon } from "@opencode/ui/icon"
 import { IconButton } from "@opencode/ui/icon-button"
+import {
+  distance,
+  DOUBLE_TAP_SCALE,
+  easeOut,
+  IDENTITY,
+  lerp,
+  midpoint,
+  MIN_SCALE,
+  pan,
+  settle,
+  zoomAround,
+  type Box,
+  type Frame,
+  type Point,
+  type Zoom,
+} from "./image-preview-zoom"
 
 export interface ImagePreviewProps {
   src: string
   alt?: string
 }
 
+const DOUBLE_TAP_WINDOW = 300
+
+/** Spring back into the allowed range after a pinch goes past the fitted size or the edge. */
+const SETTLE_DURATION = 180
+
+/**
+ * A full-screen preview that zooms itself.
+ *
+ * Desktop relies on the browser's page-level pinch zoom; the Android WebView host disables that
+ * (`setSupportZoom(false)`), so the preview carries its own pinch / double-tap / drag handling and
+ * behaves the same on every host.
+ */
 export function ImagePreview(props: ImagePreviewProps) {
   const i18n = useI18n()
+  const [zoom, setZoom] = createSignal<Zoom>(IDENTITY)
+  // The picture's fitted size at scale 1. The <img> box is set to exactly this, so a transform
+  // scales the picture and not a full-screen box with empty bands inside it.
+  const [content, setContent] = createSignal<Box>({ width: 0, height: 0 })
+
+  let body: HTMLDivElement | undefined
+  let image: HTMLImageElement | undefined
+  // Fingers down on the body, in client coordinates, keyed per input family: one drags, two pinch.
+  const pointers = new Map<string, Point>()
+  let pinch: { distance: number; zoom: Zoom } | undefined
+  let drag: { point: Point; zoom: Zoom } | undefined
+  // A completed tap, used to recognise a double tap. Set on release, never on press: a pinch or a
+  // drag also starts with a press, and must not arm the second tap of a double tap.
+  let lastTap: { at: number; point: Point } | undefined
+  let gesture: { point: Point; at: number; moved: boolean } | undefined
+
+  const reset = () => setZoom(IDENTITY)
+
+  /**
+   * The painted picture at scale 1 and the viewport it centres in. The picture is fitted so one
+   * edge touches the matching screen edge (a 1080×1920 photo on a 1080×2180 screen fills the width
+   * and leaves bands above and below), and a smaller picture is upscaled the same way. The <img>
+   * box is sized to `content`, so panning and scaling share one coordinate space.
+   */
+  const frameOf = (): Frame => {
+    const bounds = body?.getBoundingClientRect()
+    const natural = { width: image?.naturalWidth ?? 0, height: image?.naturalHeight ?? 0 }
+    const viewport = { width: bounds?.width ?? 0, height: bounds?.height ?? 0 }
+    if (!natural.width || !natural.height) return { content: viewport, viewport }
+    const scale = Math.min(viewport.width / natural.width, viewport.height / natural.height)
+    return { content: { width: natural.width * scale, height: natural.height * scale }, viewport }
+  }
+
+  /** Re-fits the picture after a resize or load, and re-settles the zoom against the new bounds. */
+  const measure = () => {
+    const frame = frameOf()
+    setContent(frame.content)
+    setZoom((current) => settle(current, frame))
+  }
+
+  onMount(() => {
+    const observer = new ResizeObserver(() => measure())
+    if (body) observer.observe(body)
+    onCleanup(() => observer.disconnect())
+  })
+
+  /** Client coordinates to the image-centred space the transform is applied in. */
+  const focal = (point: Point): Point => {
+    const bounds = body?.getBoundingClientRect()
+    return {
+      x: point.x - (bounds?.left ?? 0) - (bounds?.width ?? 0) / 2,
+      y: point.y - (bounds?.top ?? 0) - (bounds?.height ?? 0) / 2,
+    }
+  }
+
+  const zoomAt = (client: Point, scale: number, from: Zoom) => setZoom(zoomAround(from, scale, focal(client), frameOf()))
+
+  // A single animation owns every spring back; a new gesture cancels it.
+  let spring: number | undefined
+  const stopSpring = () => {
+    if (spring === undefined) return
+    cancelAnimationFrame(spring)
+    spring = undefined
+  }
+
+  /** Eases the picture back to the allowed range: never smaller than the fit, never past the edge. */
+  const springBack = () => {
+    const target = settle(zoom(), frameOf())
+    const from = zoom()
+    if (from.scale === target.scale && from.x === target.x && from.y === target.y) return
+
+    stopSpring()
+    const started = performance.now()
+    const step = (now: number) => {
+      const t = Math.min(1, (now - started) / SETTLE_DURATION)
+      setZoom(lerp(from, target, easeOut(t)))
+      spring = t < 1 ? requestAnimationFrame(step) : undefined
+    }
+    spring = requestAnimationFrame(step)
+  }
+
+  onCleanup(stopSpring)
+
+  const onWheel = (event: WheelEvent) => {
+    if (!event.ctrlKey && !event.metaKey) return
+    event.preventDefault()
+    zoomAt({ x: event.clientX, y: event.clientY }, zoom().scale * (event.deltaY < 0 ? 1.15 : 1 / 1.15), zoom())
+  }
+
+  /**
+   * Which input family owns the current gesture. Pointer Events fire first on hosts that have them,
+   * and the compat Touch Events that follow must not be counted as a second finger; a WebView that
+   * delivers only Touch Events (no pointer events at all) is picked up by the other branch.
+   */
+  let source: "pointer" | "touch" | undefined
+
+  const begin = (key: string, point: Point, kind: "mouse" | "touch") => {
+    stopSpring()
+    pointers.set(key, point)
+
+    if (pointers.size === 1) {
+      const before = zoom()
+      drag = { point, zoom: before }
+      gesture = { point, at: performance.now(), moved: false }
+      // A double tap is decided on press against the previous completed tap, but zooming happens
+      // here so the first tap of a pinch never arms one.
+      if (kind === "touch" && lastTap && gesture.at - lastTap.at < DOUBLE_TAP_WINDOW && distance(point, lastTap.point) < 24) {
+        lastTap = undefined
+        drag = undefined
+        gesture = undefined
+        setZoom(before.scale > MIN_SCALE ? IDENTITY : zoomAround(IDENTITY, DOUBLE_TAP_SCALE, focal(point), frameOf()))
+      }
+    }
+
+    if (pointers.size === 2) {
+      const [a, b] = [...pointers.values()]
+      pinch = { distance: distance(a, b), zoom: zoom() }
+      drag = undefined
+    }
+  }
+
+  const move = (key: string, point: Point) => {
+    if (!pointers.has(key)) return
+    pointers.set(key, point)
+    if (gesture && distance(point, gesture.point) > 8) gesture.moved = true
+
+    if (pointers.size >= 2 && pinch) {
+      const [a, b] = [...pointers.values()]
+      if (!pinch.distance) return
+      zoomAt(midpoint(a, b), pinch.zoom.scale * (distance(a, b) / pinch.distance), pinch.zoom)
+      return
+    }
+
+    if (pointers.size === 1 && drag) {
+      setZoom(pan(drag.zoom, point.x - drag.point.x, point.y - drag.point.y, frameOf()))
+    }
+  }
+
+  const end = (key: string, kind: "mouse" | "touch") => {
+    pointers.delete(key)
+    // Only a still, single-finger touch that was not part of a pinch arms the next tap; that is what
+    // keeps a pinch's first finger from being mistaken for the second tap of a double tap.
+    if (gesture && pointers.size === 0) {
+      if (kind === "mouse" || gesture.moved) lastTap = undefined
+      else lastTap = { at: performance.now(), point: gesture.point }
+      gesture = undefined
+    }
+
+    if (pointers.size < 2) pinch = undefined
+    if (pointers.size === 0) {
+      drag = undefined
+      // Releasing is where an over-pinch below the fit, or a drag past the edge, comes back.
+      springBack()
+      return
+    }
+    // Dropping from two fingers to one restarts the drag from where that finger is now.
+    const point = [...pointers.values()][0]
+    drag = { point, zoom: zoom() }
+  }
+
+  const onPointerDown = (event: PointerEvent) => {
+    if (event.pointerType === "mouse" && event.button !== 0) return
+    source = "pointer"
+    const key = `p${event.pointerId}`
+    begin(key, { x: event.clientX, y: event.clientY }, event.pointerType === "mouse" ? "mouse" : "touch")
+    // Capture keeps the gesture alive when a finger leaves the body. It needs a live pointer, so a
+    // host that reports none (synthetic events, some embedded WebViews) must still get the gesture.
+    try {
+      body?.setPointerCapture(event.pointerId)
+    } catch {}
+  }
+
+  const onPointerMove = (event: PointerEvent) => {
+    if (source !== "pointer") return
+    move(`p${event.pointerId}`, { x: event.clientX, y: event.clientY })
+  }
+
+  const onPointerUp = (event: PointerEvent) => {
+    if (source !== "pointer") return
+    try {
+      if (body?.hasPointerCapture(event.pointerId)) body.releasePointerCapture(event.pointerId)
+    } catch {}
+    end(`p${event.pointerId}`, event.pointerType === "mouse" ? "mouse" : "touch")
+  }
+
+  const onTouchStart = (event: TouchEvent) => {
+    if (source === "pointer") return
+    source = "touch"
+    event.preventDefault()
+    for (const touch of [...event.changedTouches]) begin(`t${touch.identifier}`, { x: touch.clientX, y: touch.clientY }, "touch")
+  }
+
+  const onTouchMove = (event: TouchEvent) => {
+    if (source !== "touch") return
+    event.preventDefault()
+    for (const touch of [...event.changedTouches]) move(`t${touch.identifier}`, { x: touch.clientX, y: touch.clientY })
+  }
+
+  const onTouchEnd = (event: TouchEvent) => {
+    if (source !== "touch") return
+    event.preventDefault()
+    for (const touch of [...event.changedTouches]) end(`t${touch.identifier}`, "touch")
+  }
+
+  /**
+   * The body owns the gesture listeners directly: `preventDefault` needs non-passive handlers, and
+   * the element must react to whichever family (Pointer or Touch) this WebView actually delivers.
+   */
+  const attach = (element: HTMLDivElement) => {
+    body = element
+    const listeners: [string, EventListener][] = [
+      ["pointerdown", onPointerDown as EventListener],
+      ["pointermove", onPointerMove as EventListener],
+      ["pointerup", onPointerUp as EventListener],
+      ["pointercancel", onPointerUp as EventListener],
+      ["touchstart", onTouchStart as EventListener],
+      ["touchmove", onTouchMove as EventListener],
+      ["touchend", onTouchEnd as EventListener],
+      ["touchcancel", onTouchEnd as EventListener],
+    ]
+    for (const [type, listener] of listeners) element.addEventListener(type, listener, { passive: false })
+    const wheel = (event: Event) => onWheel(event as WheelEvent)
+    element.addEventListener("wheel", wheel, { passive: false })
+    onCleanup(() => {
+      for (const [type, listener] of listeners) element.removeEventListener(type, listener)
+      element.removeEventListener("wheel", wheel)
+    })
+  }
 
   return (
     <div data-component="image-preview">
       <div data-slot="image-preview-container">
         <Kobalte.Content data-slot="image-preview-content">
           <div data-slot="image-preview-header">
+            <Show when={zoom().scale > MIN_SCALE}>
+              <IconButton
+                data-action="image-preview-reset"
+                icon={<Icon name="magnifying-glass" />}
+                variant="ghost"
+                aria-label={i18n.t("ui.imagePreview.reset")}
+                onClick={reset}
+              />
+            </Show>
             <Kobalte.CloseButton
               data-slot="image-preview-close"
               as={IconButton}
@@ -24,8 +290,35 @@ export function ImagePreview(props: ImagePreviewProps) {
               aria-label={i18n.t("ui.common.close")}
             />
           </div>
-          <div data-slot="image-preview-body">
-            <img src={props.src} alt={props.alt ?? i18n.t("ui.imagePreview.alt")} data-slot="image-preview-image" />
+          <div
+            data-slot="image-preview-body"
+            data-zoomed={zoom().scale > MIN_SCALE ? "" : undefined}
+            ref={attach}
+            onDblClick={(event) =>
+              setZoom(
+                zoom().scale > MIN_SCALE
+                  ? IDENTITY
+                  : zoomAround(IDENTITY, DOUBLE_TAP_SCALE, focal({ x: event.clientX, y: event.clientY }), frameOf()),
+              )
+            }
+          >
+            <img
+              src={props.src}
+              alt={props.alt ?? i18n.t("ui.imagePreview.alt")}
+              data-slot="image-preview-image"
+              draggable={false}
+              ref={(element) => {
+                image = element
+                // Fit the box once the natural size is known; the observer handles the rest.
+                element.addEventListener("load", measure)
+                onCleanup(() => element.removeEventListener("load", measure))
+              }}
+              style={{
+                width: content().width ? `${content().width}px` : undefined,
+                height: content().height ? `${content().height}px` : undefined,
+                transform: `translate(${zoom().x}px, ${zoom().y}px) scale(${zoom().scale})`,
+              }}
+            />
           </div>
         </Kobalte.Content>
       </div>

diff --git a/packages/ui/src/components/image-preview.css b/packages/ui/src/components/image-preview.css
