     position: relative;
     z-index: 50;
-    width: min(calc(100vw - 32px), 90vw);
-    max-width: 1200px;
-    height: min(calc(100vh - 32px), 90vh);
+    width: 100%;
+    height: 100%;
     display: flex;
     flex-direction: column;
     align-items: center;
     justify-content: center;
 
     [data-slot="image-preview-content"] {
+      position: relative;
       display: flex;
       flex-direction: column;
       align-items: center;
       width: 100%;
-      max-height: 100%;
-      border-radius: var(--radius-lg);
-      background: var(--surface-raised-stronger-non-alpha);
-      box-shadow:
-        0 15px 45px 0 rgba(19, 16, 16, 0.35),
-        0 3.35px 10.051px 0 rgba(19, 16, 16, 0.25),
-        0 0.998px 2.993px 0 rgba(19, 16, 16, 0.2);
+      height: 100%;
       overflow: hidden;
 
       &:focus-visible {
         outline: none;
       }
 
+      /* Floating over the picture, so the picture itself can use the whole screen. Each control
+         keeps a solid surface behind it, or it would vanish against a photo. */
       [data-slot="image-preview-header"] {
+        position: absolute;
+        inset-block-start: 0;
+        inset-inline: 0;
+        z-index: 2;
         display: flex;
-        padding: 8px 8px 0;
+        gap: 6px;
+        padding: 8px;
         justify-content: flex-end;
         align-items: center;
-        align-self: stretch;
+        pointer-events: none;
+
+        > * {
+          pointer-events: auto;
+          background: var(--v2-background-bg-base, #fff);
+          border-radius: 999px;
+          box-shadow: 0 1px 4px rgba(0, 0, 0, 0.28);
+        }
       }
 
       [data-slot="image-preview-body"] {
+        position: relative;
+        flex: 1;
         width: 100%;
+        min-height: 0;
         display: flex;
         align-items: center;
         justify-content: center;
-        padding: 16px;
-        overflow: auto;
+        overflow: hidden;
+        touch-action: none;
+
+        &[data-zoomed] {
+          cursor: grab;
+        }
+
+        &[data-zoomed]:active {
+          cursor: grabbing;
+        }
       }
 
       [data-slot="image-preview-image"] {
+        /* The box is the picture, not the viewport: `max-*: 100%` with an auto size fits the
+           longest edge to the screen (and upscales a smaller picture), so the transform scales
+           the picture itself instead of scaling a full-screen box with empty letterbox bands in
