diff --git a/packages/app/src/shell/layout/vertical.ts b/packages/app/src/shell/layout/vertical.ts
new file mode 100644
index 0000000..350aec6
--- /dev/null
+++ b/packages/app/src/shell/layout/vertical.ts
@@ -0,0 +1,14 @@
+import { createMediaQuery } from "@solid-primitives/media"
+import { useSettings } from "@/settings/model"
+
+/**
+ * The vertical-tabs shell is desktop-only: phone widths keep the horizontal titlebar even when the
+ * stored preference is "vertical". Every surface that must branch on the effective layout reads
+ * this one accessor so routing and chrome cannot disagree.
+ */
+export function useVerticalTabs() {
+  const settings = useSettings()
+  const mobile = createMediaQuery("(max-width: 767px)")
+
+  return () => settings.appearance.tabLayout() === "vertical" && !mobile()
+}

diff --git a/packages/app/src/shell/routes/routes.tsx b/packages/app/src/shell/routes/routes.tsx
index 33b0058..81e12e7 100644
--- a/packages/app/src/shell/routes/routes.tsx
+++ b/packages/app/src/shell/routes/routes.tsx
@@ -1,11 +1,14 @@
 import { Route, useParams } from "@solidjs/router"
-import { createMemo, lazy, Show, Suspense, type ParentProps } from "solid-js"
+import { createEffect, createMemo, lazy, Show, Suspense, type ParentProps } from "solid-js"
 import { Home } from "@/home/route"
 import { ServerProvider } from "@/runtime/server/current"
 import { useGlobal } from "@/runtime/server/runtime"
 import { ServerConnection, useServers } from "@/runtime/server/registry"
 import { SessionPanelFrame, SessionRouteFrame } from "@/session/session-frame"
-import { LayoutProvider } from "@/shell/state/layout"
+import { LayoutProvider, useLayout } from "@/shell/state/layout"
+import { useVerticalTabs } from "@/shell/layout/vertical"
+import { useTabs } from "@/shell/tabs/tabs"
+import { useSettings } from "@/settings/model"
 import { SettingsSurfaceProvider } from "@/settings/surface"
 import Shell from "@/shell/shell"
 import { requireServerKey } from "./session"
@@ -43,7 +46,7 @@ export function preloadRoute(url: string) {
 export function AppRoutes() {
   return (
     <Route component={AppLayout}>
-      <Route path="/" component={Home} />
+      <Route path="/" component={HomeRoute} />
       <Route path="/settings" component={SettingsScreen} />
       <Route
         path="/server/:serverKey/session/:id"
@@ -108,3 +111,91 @@ function AppLayout(props: ParentProps) {
     </Show>
   )
 }
+
+/**
+ * The root route is Home only for the horizontal shell. With vertical tabs the sidebar's project
+ * tree is the navigation surface and Home has no entry point, so the root becomes the unsent-draft
+ * screen instead. The decision lives here so a bookmark, browser history, Android back, or a
+ * layout switch cannot render Home while vertical tabs are active.
+ */
+function HomeRoute() {
+  const settings = useSettings()
+  const vertical = useVerticalTabs()
+
+  return (
+    // Wait for the stored layout preference first: rendering Home while settings hydrate would
+    // flash it on every vertical-tabs start even though it is never the destination.
+    <Show when={settings.ready()} fallback={null}>
+      <Show when={!vertical()} fallback={<NewDraftHome />}>
+        <Home />
+      </Show>
+    </Show>
+  )
+}
+
+// One redirect at a time: leaving the root navigates asynchronously, and a remount during that
+// window must not append a second empty draft.
+let redirecting = false
+
+function NewDraftHome() {
+  const tabs = useTabs()
+  const layout = useLayout()
+  const global = useGlobal()
+  const servers = useServers()
+  let settled = false
+
+  // Same project order the Home page uses for "new session": selected, then last used, then first.
+  // `sync.data.project` covers a fresh window whose local project registry has not opened anything
+  // yet, and the server's own directory is the last resort for a server with no projects at all.
+  const target = createMemo(() => {
+    const selection = layout.home.selection()
+    const conn = servers.visible.find((item) => ServerConnection.key(item) === selection.server) ?? servers.visible[0]
+
+    if (!conn) return
+    const ctx = global.ensureServerCtx(conn)
+    const projects = ctx.projects.list()
+    const last = ctx.projects.last()
+    const directory =
+      projects.find((item) => item.worktree === selection.directory)?.worktree ??
+      projects.find((item) => item.worktree === last)?.worktree ??
+      projects[0]?.worktree ??
+      ctx.sync.data.project[0]?.worktree ??
+      ctx.sync.data.path.directory
+
+    if (!directory) return
+    return { conn, directory }
+  })
+
+  createEffect(() => {
+    if (settled || redirecting) return
+    // Project state is persisted separately from tabs and servers; wait for all three so a fresh
+    // window can reuse an existing draft instead of creating a duplicate empty one.
+    if (!tabs.ready() || !servers.hydrated()) return
+
+    const visible = new Set(servers.visible.map((item) => ServerConnection.key(item)))
+    const existing = tabs.store.findLast((tab) => tab.type === "draft" && visible.has(tab.server))
+
+    if (existing) {
+      settled = true
+      tabs.select(existing)
+      return
+    }
+
+    const next = target()
+
+    if (!next) return
+    settled = true
+    redirecting = true
+    const ctx = global.ensureServerCtx(next.conn)
+    ctx.projects.open(next.directory)
+    ctx.projects.touch(next.directory)
+    void tabs
+      .newDraft({ server: ServerConnection.key(next.conn), directory: next.directory })
+      .catch(() => undefined)
+      .finally(() => {
+        redirecting = false
+      })
+  })
+
+  return null
+}

