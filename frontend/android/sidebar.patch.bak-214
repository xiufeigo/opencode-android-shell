diff --git a/packages/ui/src/components/image-preview-zoom.ts b/packages/ui/src/components/image-preview-zoom.ts
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/packages/ui/src/components/image-preview-zoom.ts
@@ -0,0 +1,120 @@
+/**
+ * Geometry for the image preview's own pinch / double-tap / drag zoom.
+ *
+ * The preview applies `translate(x, y) scale(scale)` about the image centre, so a focal point given
+ * in viewport coordinates relative to that centre stays put while the scale changes:
+ *
+ *   translation' = focal - (focal - translation) * (scale' / scale)
+ *
+ * Scale `1` is the fitted size: the picture is contained in the viewport, so one edge touches the
+ * matching screen edge (a 1080×1920 photo on a 1080×2180 screen spans the full width and leaves
+ * bands above and below). That is the resting minimum — the picture never *stays* smaller than the
+ * screen — but a pinch may pull it below while the fingers are down, and `settle` is the target it
+ * springs back to on release.
+ *
+ * Panning is bounded by what is actually painted (`content`), not by the element box it sits in: a
+ * contained picture is narrower than the viewport on one axis, and bounding by the element would
+ * let a zoomed picture be dragged off screen.
+ *
+ * Kept apart from the component so the arithmetic is testable without a DOM.
+ */
+
+export const MIN_SCALE = 1
+export const MAX_SCALE = 6
+
+/** How much of an over-pinch below the fitted size shows through, for the spring back. */
+export const RUBBER_RESISTANCE = 0.35
+
+/** Scale a double tap jumps to, and back from. */
+export const DOUBLE_TAP_SCALE = 2.5
+
+export type Point = { x: number; y: number }
+
+export type Box = { width: number; height: number }
+
+/** The painted picture at scale 1, and the viewport it is centred in. */
+export type Frame = { content: Box; viewport: Box }
+
+export type Zoom = { scale: number; x: number; y: number }
+
+export const IDENTITY: Zoom = { scale: MIN_SCALE, x: 0, y: 0 }
+
+/**
+ * The scale a gesture actually shows. Above the fitted size it clamps at the maximum; below it the
+ * overshoot is damped, so the picture follows the pinch without collapsing, then springs back.
+ */
+export function resist(scale: number) {
+  if (!Number.isFinite(scale)) return MIN_SCALE
+  if (scale >= MIN_SCALE) return Math.min(MAX_SCALE, scale)
+
+  return MIN_SCALE - (MIN_SCALE - scale) * RUBBER_RESISTANCE
+}
+
+/**
+ * Keeps the picture from being dragged off screen. Once the scaled picture is wider (or taller)
+ * than the viewport it may move by half the overflow; while it is narrower, that axis stays centred.
+ */
+export function clampTranslate(zoom: Zoom, frame: Frame): Zoom {
+  const maxX = Math.max(0, (frame.content.width * zoom.scale - frame.viewport.width) / 2)
+  const maxY = Math.max(0, (frame.content.height * zoom.scale - frame.viewport.height) / 2)
+
+  return {
+    scale: zoom.scale,
+    x: Math.min(maxX, Math.max(-maxX, zoom.x)),
+    y: Math.min(maxY, Math.max(-maxY, zoom.y)),
+  }
+}
+
+/** Scales about `focal`, so the screen point under the fingers stays under the fingers. */
+export function zoomAround(zoom: Zoom, nextScale: number, focal: Point, frame: Frame): Zoom {
+  const scale = resist(nextScale)
+
+  if (scale === zoom.scale) return zoom
+
+  const ratio = scale / zoom.scale
+
+  return clampTranslate(
+    {
+      scale,
+      x: focal.x - (focal.x - zoom.x) * ratio,
+      y: focal.y - (focal.y - zoom.y) * ratio,
+    },
+    frame,
+  )
+}
+
+export function pan(zoom: Zoom, dx: number, dy: number, frame: Frame): Zoom {
+  return clampTranslate({ scale: zoom.scale, x: zoom.x + dx, y: zoom.y + dy }, frame)
+}
+
+/**
+ * Where a released gesture rests: the scale is never below the fit, and the translation never runs
+ * past the painted edge at that scale. A pinch below the fit therefore returns to the screen-filling
+ * size.
+ */
+export function settle(zoom: Zoom, frame: Frame): Zoom {
+  return clampTranslate(
+    { scale: Math.min(MAX_SCALE, Math.max(MIN_SCALE, zoom.scale)), x: zoom.x, y: zoom.y },
+    frame,
+  )
+}
+
+export function easeOut(t: number) {
+  return 1 - (1 - t) ** 3
+}
+
+export function lerp(from: Zoom, to: Zoom, t: number): Zoom {
+  return {
+    scale: from.scale + (to.scale - from.scale) * t,
+    x: from.x + (to.x - from.x) * t,
+    y: from.y + (to.y - from.y) * t,
+  }
+}
+
+export function distance(a: Point, b: Point) {
+  return Math.hypot(a.x - b.x, a.y - b.y)
+}
+
+export function midpoint(a: Point, b: Point): Point {
+  return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }
+}

diff --git a/packages/ui/src/components/image-preview-zoom.test.ts b/packages/ui/src/components/image-preview-zoom.test.ts
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/packages/ui/src/components/image-preview-zoom.test.ts
@@ -0,0 +1,105 @@
+import { describe, expect, test } from "bun:test"
+import {
+  clampTranslate,
+  DOUBLE_TAP_SCALE,
+  easeOut,
+  IDENTITY,
+  lerp,
+  MAX_SCALE,
+  MIN_SCALE,
+  midpoint,
+  pan,
+  resist,
+  RUBBER_RESISTANCE,
+  settle,
+  zoomAround,
+  type Frame,
+} from "./image-preview-zoom"
+
+// A portrait photo (1080×1920) in a wide viewport (1280×770): at scale 1 it fills the height and
+// leaves bands on the sides, so panning must bound by the painted picture, not the viewport.
+const frame: Frame = {
+  content: { width: 433, height: 770 },
+  viewport: { width: 1280, height: 770 },
+}
+
+describe("image preview zoom", () => {
+  test("a focal zoom keeps the point under the fingers", () => {
+    // A picture already larger than its viewport, so no axis stays centred.
+    const wide: Frame = { content: { width: 400, height: 200 }, viewport: { width: 400, height: 200 } }
+    const focal = { x: 100, y: 50 }
+    const next = zoomAround(IDENTITY, 2, focal, wide)
+
+    expect(next.scale).toBe(2)
+    expect((focal.x - next.x) / next.scale).toBeCloseTo(focal.x, 5)
+    expect((focal.y - next.y) / next.scale).toBeCloseTo(focal.y, 5)
+  })
+
+  test("a narrow picture stays centred while the zoom does not yet overflow", () => {
+    // 433 * 2 = 866 is still narrower than the 1280 viewport, so the focal point cannot be honoured
+    // on that axis: the picture stays centred instead of sliding out of view.
+    const next = zoomAround(IDENTITY, 2, { x: 300, y: 0 }, frame)
+
+    expect(next.x).toBeCloseTo(0, 6)
+  })
+
+  test("zoom in clamps at the maximum", () => {
+    expect(zoomAround(IDENTITY, 99, { x: 0, y: 0 }, frame).scale).toBe(MAX_SCALE)
+  })
+
+  test("a pinch below the fit is damped, not clamped, so it can spring back", () => {
+    expect(resist(0.5)).toBeCloseTo(MIN_SCALE - (MIN_SCALE - 0.5) * RUBBER_RESISTANCE, 6)
+    expect(resist(0.5)).toBeLessThan(MIN_SCALE)
+    expect(resist(0.5)).toBeGreaterThan(0)
+  })
+
+  test("release never rests below the fitted size", () => {
+    expect(settle({ scale: 0.5, x: 0, y: 0 }, frame)).toEqual({ scale: MIN_SCALE, x: 0, y: 0 })
+  })
+
+  test("a picture narrower than the screen stays horizontally centred", () => {
+    // At 1x the photo is 433 wide in a 1280 viewport: no horizontal travel is legal.
+    expect(clampTranslate({ scale: 1, x: 200, y: 0 }, frame)).toEqual({ scale: 1, x: 0, y: 0 })
+    expect(clampTranslate({ scale: 2, x: 500, y: 500 }, frame)).toEqual({ scale: 2, x: 0, y: 385 })
+  })
+
+  test("once the picture is wider than the screen it may pan by the overflow", () => {
+    // 433 * 4 = 1732 wide, so (1732 - 1280) / 2 = 226 of travel each way.
+    expect(clampTranslate({ scale: 4, x: 1000, y: 0 }, frame)).toEqual({ scale: 4, x: 226, y: 0 })
+  })
+
+  test("panning and settling agree with the clamp", () => {
+    const zoomed = zoomAround(IDENTITY, 3, { x: 0, y: 0 }, frame)
+
+    expect(pan(zoomed, 5000, 5000, frame)).toEqual(clampTranslate({ scale: 3, x: 5000, y: 5000 }, frame))
+    expect(settle({ scale: 3, x: 5000, y: -5000 }, frame)).toEqual(clampTranslate({ scale: 3, x: 5000, y: -5000 }, frame))
+  })
+
+  test("a zero-sized picture never produces a non-zero bound", () => {
+    const empty: Frame = { content: { width: 0, height: 0 }, viewport: { width: 1280, height: 770 } }
+    const zoomed = zoomAround(IDENTITY, 2, { x: 0, y: 0 }, empty)
+
+    expect(zoomed).toEqual({ scale: 2, x: 0, y: 0 })
+  })
+
+  test("double tap alternates between the fit and the detail scale", () => {
+    const zoomed = zoomAround(IDENTITY, DOUBLE_TAP_SCALE, { x: 0, y: 0 }, frame)
+
+    expect(zoomed.scale).toBe(DOUBLE_TAP_SCALE)
+    expect(settle(zoomed, frame)).toEqual(zoomed)
+  })
+
+  test("the ease-out spring covers the whole distance by the last frame", () => {
+    const from = { scale: 0.6, x: 0, y: 0 }
+    const to = { scale: 1, x: 0, y: 0 }
+
+    expect(easeOut(0)).toBe(0)
+    expect(easeOut(1)).toBe(1)
+    expect(lerp(from, to, 0)).toEqual(from)
+    expect(lerp(from, to, 1)).toEqual(to)
+  })
+
+  test("midpoint measures two pointers", () => {
+    expect(midpoint({ x: 10, y: 20 }, { x: 30, y: 40 })).toEqual({ x: 20, y: 30 })
+  })
+})
