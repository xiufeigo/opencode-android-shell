diff --git a/packages/app/src/utils/android-tab-plus.ts b/packages/app/src/utils/android-tab-plus.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/packages/app/src/utils/android-tab-plus.ts
@@ -0,0 +1,67 @@
+import { createSignal } from "solid-js"
+
+export const ANDROID_TAB_PLUS_STORAGE_KEY = "opencode.android.tabPlusCreatesSession"
+
+export function isAndroidWebview() {
+  return typeof document !== "undefined" && document.documentElement.hasAttribute("data-android-webview")
+}
+
+function readStoredCreatesSession() {
+  try {
+    return globalThis.localStorage?.getItem(ANDROID_TAB_PLUS_STORAGE_KEY) === "true"
+  } catch {
+    return false
+  }
+}
+
+const [createsSession, setCreatesSession] = createSignal(false)
+let hydrated = false
+
+function hydrate() {
+  if (hydrated) return
+  hydrated = true
+  setCreatesSession(readStoredCreatesSession())
+}
+
+export function androidTabPlusCreatesSession() {
+  hydrate()
+  return createsSession()
+}
+
+export function setAndroidTabPlusCreatesSession(value: boolean) {
+  hydrate()
+  setCreatesSession(!!value)
+  try {
+    globalThis.localStorage?.setItem(ANDROID_TAB_PLUS_STORAGE_KEY, value ? "true" : "false")
+  } catch {
+    // Private mode / quota should not break the tab bar.
+  }
+}
+
+export type TabPlusCommand = {
+  options: { id: string }[]
+  show: () => void
+  trigger: (id: string, source?: "palette" | "keybind" | "slash") => void
+}
+
+/** Android default: tab-bar + opens Ctrl+P (file.open / command palette). Toggle restores Desktop new-session. */
+export function openTitlebarTabPlus(command: TabPlusCommand, openNewTab: () => void) {
+  if (!isAndroidWebview() || androidTabPlusCreatesSession()) {
+    openNewTab()
+    return
+  }
+  if (command.options.some((option) => option.id === "file.open")) {
+    command.trigger("file.open", "palette")
+    return
+  }
+  command.show()
+}
+
+if (typeof window !== "undefined") {
+  const api = {
+    key: ANDROID_TAB_PLUS_STORAGE_KEY,
+    get: androidTabPlusCreatesSession,
+    set: setAndroidTabPlusCreatesSession,
+  }
+  ;(window as Window & { __ocAndroidTabPlus?: typeof api }).__ocAndroidTabPlus = api
+}

