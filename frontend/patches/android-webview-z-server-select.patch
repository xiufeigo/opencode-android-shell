+/** When `active` is missing from the list (e.g. Android `"offline"`), pick default or first. */
+export function resolveActiveServerKey(
+  servers: ServerConnection.Any[],
+  active: ServerConnection.Key,
+  fallback: ServerConnection.Key,
+) {
+  const keys = servers.map((server) => ServerConnection.key(server))
+  if (keys.includes(active)) return active
+  if (fallback && keys.includes(fallback)) return fallback
+  return keys[0] ?? fallback
+}
