+/* Android / narrow portrait: official CSS only shrinks the 240px sidebar to 144px
+   (max-width 639px). That still two-columns a ~390–800px viewport and clips
+   controls. Stack to a single column below 840px; landscape tablets stay row. */
+@media (max-width: 839px) {
+  [data-component="dialog-v2"][data-variant="settings"] [data-slot="dialog-container"] {
+    width: min(calc(100vw - 16px), 980px);
+    height: min(calc(100dvh - 16px), 720px);
+  }
+
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"] {
+    flex-direction: column;
+  }
+
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"]
+    [data-slot="tabs-v2-list"] {
+    box-sizing: border-box;
+    width: 100%;
+    min-width: 0;
+    height: auto;
+    max-height: none;
+    flex: 0 0 auto;
+    flex-direction: column;
+    padding: 8px;
+    overflow-x: hidden;
+    overflow-y: visible;
+    border-inline-end: none;
+    border-bottom: 1px solid var(--v2-border-border-base);
+  }
+
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"][data-orientation="vertical"]
+    [data-slot="tabs-v2-list"]
+    > div {
+    height: auto;
+  }
+
+  .settings-v2-nav-footer {
+    display: none;
+  }
+
+  .settings-v2-tab-header {
+    padding: 20px 16px 16px;
+  }
+
+  .settings-v2-tab-body {
+    padding: 0 16px 24px;
+    gap: 24px;
+  }
+
+  [data-component="dialog-v2"][data-variant="settings"] [data-component="select-v2-root"],
+  [data-component="dialog-v2"][data-variant="settings"] [data-component="button-v2"] {
+    width: 100%;
+    max-width: 100%;
+  }
+
+  [data-slot="settings-v2-row-control"] {
+    width: 100%;
+    justify-content: flex-start;
+  }
+
+  [data-component="settings-v2-row"],
+  .settings-v2-provider-row,
+  .settings-v2-servers-row {
+    flex-direction: column;
+    align-items: stretch;
+    flex-wrap: wrap;
+  }
+
+  [data-slot="settings-v2-row-copy"] {
+    width: 100%;
+    max-width: 100%;
+  }
+
+  [data-slot="settings-v2-row-title"],
+  [data-slot="settings-v2-row-description"] {
+    white-space: normal;
+    overflow: visible;
+    text-overflow: unset;
+  }
+}
