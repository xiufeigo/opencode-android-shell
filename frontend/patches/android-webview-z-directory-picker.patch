new file mode 100644
--- /dev/null
+++ b/packages/app/src/components/dialog-select-directory-android.css
@@ -0,0 +1,28 @@
+/* Android shell: staged (tapped, not yet confirmed) directory row.
+ *
+ * The wrapper is display:contents so the flex-column list layout still sees
+ * the row button directly; the attribute selector keeps working because the
+ * DOM parent is unchanged. */
+[data-android-staged] {
+  display: contents;
+}
+
+html[data-android-webview] [data-android-staged] > [data-slot="list-item"] {
+  background: var(--v2-overlay-simple-overlay-hover, rgba(255, 255, 255, 0.08));
+}
+
+.directory-picker-android-footer {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 8px 12px 12px;
+}
+
+.directory-picker-android-selection {
+  min-height: 20px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--v2-text-text-muted, #888);
+  font-size: 12px;
+}
