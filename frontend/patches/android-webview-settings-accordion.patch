diff --git a/packages/app/src/components/settings-v2/parts/section.tsx b/packages/app/src/components/settings-v2/parts/section.tsx
new file mode 100644
index 0000000..644a6c4
--- /dev/null
+++ b/packages/app/src/components/settings-v2/parts/section.tsx
@@ -0,0 +1,17 @@
+import type { Component, JSX } from "solid-js"
+import "../settings-v2.css"
+
+/** Collapsible settings block. Native <details> so several panels can stay open
+ *  (AccordionV2 is single-card chrome and single-open by default). */
+export const SettingsSectionV2: Component<{
+  title?: string | JSX.Element
+  children: JSX.Element
+  defaultOpen?: boolean
+}> = (props) => {
+  return (
+    <details class="settings-v2-section" open={props.defaultOpen !== false} data-component="settings-v2-section">
+      {props.title ? <summary class="settings-v2-section-title">{props.title}</summary> : null}
+      {props.children}
+    </details>
+  )
+}
diff --git a/packages/app/src/components/settings-v2/settings-v2.css b/packages/app/src/components/settings-v2/settings-v2.css
--- a/packages/app/src/components/settings-v2/settings-v2.css
+++ b/packages/app/src/components/settings-v2/settings-v2.css
@@ -267,6 +267,101 @@
   }
 }
 
+/* Portrait accordion / scroll-spy: official .settings-v2-tab-header is sticky, so
+   「通用」 pins over every subsection. Unstick (hide title-only headers — nav
+   already shows the category). Sticky the in-view .settings-v2-section-title
+   instead. Sections are <details> so each block collapses independently. */
+.settings-v2-section > summary.settings-v2-section-title {
+  list-style: none;
+}
+
+.settings-v2-section > summary.settings-v2-section-title::-webkit-details-marker {
+  display: none;
+}
+
+@media (max-width: 839px) {
+  .settings-v2-panel .settings-v2-tab-header {
+    position: static;
+    z-index: auto;
+    background: var(--v2-background-bg-base);
+  }
+
+  .settings-v2-panel
+    .settings-v2-tab-header:not(.settings-v2-tab-header--stacked):not(.settings-v2-servers-header) {
+    display: none;
+  }
+
+  /* Nav (flex 0) + panel { height:100% of the 720px tabs } overflows
+     dialog-content and creates a blank scroller. Fill only the remaining
+     column (flex-grow + height:0), and keep overflow on this panel. */
+  [data-component="dialog-v2"][data-variant="settings"] [data-slot="dialog-content"] {
+    min-height: 0;
+    overflow: hidden;
+  }
+
+  .settings-v2[data-component="tabs-v2"][data-variant="settings"]
+    [data-slot="tabs-v2-content"].settings-v2-panel {
+    height: 0;
+    flex: 1 1 auto;
+    min-height: 0;
+    overflow-y: auto;
+  }
+
+  .settings-v2-tab-body {
+    padding: 0 16px 8px;
+    gap: 0;
+  }
+
+  .settings-v2-section {
+    gap: 8px;
+  }
+
+  .settings-v2-section:not([open]) {
+    gap: 0;
+  }
+
+  .settings-v2-section:not([open]) > :not(summary) {
+    display: none !important;
+  }
+
+  .settings-v2-section:not([open])::details-content {
+    display: none;
+    block-size: 0;
+    overflow: hidden;
+  }
+
+  .settings-v2-section > .settings-v2-section-title,
+  .settings-v2-section > summary.settings-v2-section-title {
+    position: sticky;
+    top: 0;
+    z-index: 6;
+    box-sizing: border-box;
+    margin: 0 -16px;
+    padding: 8px 16px;
+    background: var(--v2-background-bg-base);
+    cursor: pointer;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 8px;
+  }
+
+  .settings-v2-section > summary.settings-v2-section-title::after {
+    content: "";
+    width: 7px;
+    height: 7px;
+    flex-shrink: 0;
+    border-inline-end: 1.5px solid var(--v2-icon-icon-muted);
+    border-bottom: 1.5px solid var(--v2-icon-icon-muted);
+    transform: rotate(45deg);
+    transition: transform 160ms ease;
+  }
+
+  .settings-v2-section[open] > summary.settings-v2-section-title::after {
+    transform: rotate(-135deg);
+  }
+}
+
 .settings-v2-nav-footer {
   display: flex;
   flex-direction: column;
