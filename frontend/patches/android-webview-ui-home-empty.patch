diff --git a/packages/app/src/pages/home/android-webview-home.css b/packages/app/src/pages/home/android-webview-home.css
new file mode 100644
index 0000000..7e8d889
--- /dev/null
+++ b/packages/app/src/pages/home/android-webview-home.css
@@ -0,0 +1,28 @@
+/* Android / narrow stacked home.
+ *
+ * Official sessions body is min-h: calc(100cqh - 72px) so the list column
+ * fills the desktop card. In a stacked portrait grid that min-height sits
+ * *under* the projects row and *above* HomeUtilityNav, so empty home is
+ * always taller than the card (blank scroll to 设置/帮助).
+ *
+ * Native Activity already pads status/nav bars; CSS env(safe-area-inset-*)
+ * on the app shell would double-count inside the WebView. */
+@media (max-width: 839px) {
+  [data-slot="home-sessions-body"] {
+    min-height: 0;
+    flex: 1 1 auto;
+  }
+
+  [data-slot="home-session-scroll-track-wrap"] {
+    overflow: hidden;
+  }
+
+  [data-component="home-session-scroll-track"] {
+    height: 0;
+  }
+}
+
+html[data-android-webview] [data-slot="app-shell"] {
+  padding-top: 0 !important;
+  padding-bottom: 0 !important;
+}
