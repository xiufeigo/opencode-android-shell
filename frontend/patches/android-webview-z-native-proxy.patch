diff --git a/packages/app/src/utils/android-proxy.test.ts b/packages/app/src/utils/android-proxy.test.ts
new file mode 100644
index 0000000..ef8ec4e
--- /dev/null
+++ b/packages/app/src/utils/android-proxy.test.ts
@@ -0,0 +1,35 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { androidProxyBaseUrl, isDisconnectedStubUrl } from "./android-proxy"
+
+describe("androidProxyBaseUrl", () => {
+  afterEach(() => {
+    delete window.OpenCodeAndroid
+    delete window.__ocAndroidProxy
+  })
+
+  test("leaves the real URL unchanged without a native bridge", () => {
+    expect(androidProxyBaseUrl("https://backend.opencode.xiufeigo.xyz")).toBe(
+      "https://backend.opencode.xiufeigo.xyz",
+    )
+  })
+
+  test("does not rewrite the offline stub", () => {
+    window.OpenCodeAndroid = {
+      proxyOrigin: () => "http://127.0.0.1:9",
+      proxyPrefix: () => "/opencode-proxy/tok/",
+    }
+    expect(isDisconnectedStubUrl("http://127.0.0.1:0")).toBe(true)
+    expect(androidProxyBaseUrl("http://127.0.0.1:0")).toBe("http://127.0.0.1:0")
+  })
+
+  test("rewrites onto the native proxy and keeps the real URL encodable", () => {
+    window.OpenCodeAndroid = {
+      proxyOrigin: () => "http://127.0.0.1:9",
+      proxyPrefix: () => "/opencode-proxy/tok/",
+    }
+    const real = "https://backend.opencode.xiufeigo.xyz"
+    expect(androidProxyBaseUrl(real)).toBe(
+      `http://127.0.0.1:9/opencode-proxy/tok/${encodeURIComponent(real)}`,
+    )
+  })
+})
diff --git a/packages/app/src/utils/android-proxy.ts b/packages/app/src/utils/android-proxy.ts
new file mode 100644
index 0000000..5c50261
--- /dev/null
+++ b/packages/app/src/utils/android-proxy.ts
@@ -0,0 +1,47 @@
+/** Native loopback reverse proxy injected by the Android WebView shell. */
+export type AndroidProxyConfig = { origin: string; prefix: string }
+
+function readAndroidProxyConfig(): AndroidProxyConfig | undefined {
+  if (typeof window === "undefined") return
+  try {
+    const bridge = window.OpenCodeAndroid
+    if (bridge && typeof bridge.proxyOrigin === "function" && typeof bridge.proxyPrefix === "function") {
+      const origin = bridge.proxyOrigin()
+      const prefix = bridge.proxyPrefix()
+      if (origin && prefix) return { origin, prefix }
+    }
+  } catch {}
+  const injected = window.__ocAndroidProxy
+  if (injected?.origin && injected?.prefix) return injected
+  return
+}
+
+export function isDisconnectedStubUrl(url: string) {
+  try {
+    const parsed = new URL(url)
+    const host = parsed.hostname.replace(/^\[|\]$/g, "")
+    return (host === "127.0.0.1" || host === "localhost" || host === "::1") && parsed.port === "0"
+  } catch {
+    return url.includes("127.0.0.1:0")
+  }
+}
+
+/** Rewrite a real backend base URL onto the native proxy so fetch is not subject to remote CORS. */
+export function androidProxyBaseUrl(realUrl: string) {
+  const trimmed = realUrl.trim().replace(/\/+$/, "")
+  if (!trimmed || isDisconnectedStubUrl(trimmed)) return trimmed
+  if (trimmed.includes("/opencode-proxy/")) return trimmed
+  const cfg = readAndroidProxyConfig()
+  if (!cfg) return trimmed
+  return `${cfg.origin.replace(/\/+$/, "")}${cfg.prefix}${encodeURIComponent(trimmed)}`
+}
+
+declare global {
+  interface Window {
+    OpenCodeAndroid?: {
+      proxyOrigin: () => string
+      proxyPrefix: () => string
+    }
+    __ocAndroidProxy?: AndroidProxyConfig
+  }
+}
