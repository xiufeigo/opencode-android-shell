diff --git a/packages/app/src/utils/server-health.ts b/packages/app/src/utils/server-health.ts
index 759db56..0ccc479 100644
--- a/packages/app/src/utils/server-health.ts
+++ b/packages/app/src/utils/server-health.ts
@@ -7,6 +7,64 @@ import { createStore, reconcile } from "solid-js/store"
 
 export type ServerHealth = { healthy: boolean; version?: string }
 
+/** Why add-server / health failed after `{ healthy: false }`. */
+export type ConnectFailureReason = "auth" | "cors" | "network"
+
+const ANDROID_ASSET_HOST = "appassets.androidplatform.net"
+
+function isAndroidAssetOrigin() {
+  try {
+    return typeof location === "object" && location.hostname === ANDROID_ASSET_HOST
+  } catch {
+    return false
+  }
+}
+
+function healthUrl(server: ServerConnection.HttpBase, path: "/api/health" | "/global/health") {
+  return `${server.url.replace(/\/+$/, "")}${path}`
+}
+
+function authHeaders(server: ServerConnection.HttpBase): Record<string, string> {
+  if (!server.password) return { Accept: "application/json" }
+  return {
+    Accept: "application/json",
+    Authorization: `Basic ${authTokenFromCredentials({ username: server.username, password: server.password })}`,
+  }
+}
+
+function looksLikeFetchTypeError(error: unknown) {
+  if (error instanceof TypeError) return true
+  const message = error instanceof Error ? error.message : String(error)
+  return /failed to fetch|load failed|networkerror|cors/i.test(message)
+}
+
+/**
+ * Classify a failed health check so the Android add-server dialog can show CORS vs auth vs network.
+ * Official clients on Desktop/web are same-origin or allowlisted (`oc://renderer`); the WebView origin
+ * `https://appassets.androidplatform.net` is not, so CORS TypeError is the usual Android false "offline".
+ */
+export async function explainConnectFailure(
+  server: ServerConnection.HttpBase,
+  fetchFn: typeof globalThis.fetch,
+): Promise<ConnectFailureReason> {
+  const url = healthUrl(server, "/api/health")
+  try {
+    const response = await fetchFn(url, { method: "GET", headers: authHeaders(server) })
+    if (response.status === 401 || response.status === 403) return "auth"
+    return "network"
+  } catch (error) {
+    if (!looksLikeFetchTypeError(error) || !isAndroidAssetOrigin()) return "network"
+    try {
+      // Opaque success means TCP/TLS reached the host; a CORS TypeError on the credentialed
+      // request is then almost certainly a missing Access-Control-Allow-Origin for this origin.
+      await fetchFn(url, { method: "GET", mode: "no-cors" })
+      return "cors"
+    } catch {
+      return "network"
+    }
+  }
+}
+
 interface CheckServerHealthOptions {
   timeoutMs?: number
   signal?: AbortSignal
