+  const mobileContextOpen = createMemo(() => {
+    if (isDesktop()) return false
+    if (!params.id) return false
+    const active = tabs().active()
+    const listed = tabs().all().includes("context")
+    return (active === "context" || listed) && view().reviewPanel.opened()
+  })
+
+  const closeMobileContext = () => {
+    tabs().close("context")
+    const sessionView = view()
+    const hasOther = tabs()
+      .all()
+      .some((tab) => tab !== "context" && tab !== "review")
+    if (sessionView.reviewPanel.source() === "context-button" && !hasOther) sessionView.reviewPanel.close()
+  }
+
+  createEffect(() => {
+    if (!mobileContextOpen()) return
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key !== "Escape") return
+      event.preventDefault()
+      event.stopPropagation()
+      closeMobileContext()
+    }
+    makeEventListener(window, "keydown", onKeyDown, { capture: true })
+  })
+
   return (
     <SessionRouteFrame>
       <SessionHeader />
+      <Show when={mobileContextOpen()}>
+        <div
+          data-component="android-session-context"
+          data-slot="session-context-panel"
+          role="dialog"
+          aria-modal="true"
+          aria-label={language.t("session.tab.context")}
+          class="android-session-context-overlay"
+        >
+          <div class="android-session-context-header">
+            <button
+              type="button"
+              data-action="session-context-close"
+              data-slot="dialog-close-button"
+              aria-label={language.t("common.closeTab")}
+              onClick={closeMobileContext}
+            >
+              <span aria-hidden="true">×</span>
+            </button>
+            <div class="android-session-context-title">{language.t("session.tab.context")}</div>
+          </div>
+          <div class="android-session-context-body">
+            <SessionContextTab />
+          </div>
+        </div>
+      </Show>
       <div
         ref={panelRow}
         class="flex-1 min-h-0 flex flex-col md:flex-row"
