+/** Not listed in Settings. Used so server-scoped providers can init with zero configured servers. */
+export const DISCONNECTED_HTTP_SERVER: ServerConnection.Http = {
+  type: "http",
+  http: { url: "http://127.0.0.1:0" },
+}
+
+export function isDisconnectedHttp(conn?: ServerConnection.Any) {
+  if (!conn || conn.type !== "http") return false
+  try {
+    const url = new URL(conn.http.url)
+    const host = url.hostname.replace(/^\[|\]$/g, "")
+    return (host === "127.0.0.1" || host === "localhost" || host === "::1") && url.port === "0"
+  } catch {
+    return conn.http.url.includes("127.0.0.1:0")
+  }
+}
+
+/** Never hits the network. Keeps Layout/ServerSDK alive with zero configured backends. */
+export const disconnectedFetch: typeof fetch = async (_input, init) => {
+  if (init?.signal?.aborted) throw new DOMException("Aborted", "AbortError")
+  return new Response(JSON.stringify({ healthy: false, disconnected: true }), {
+    status: 503,
+    statusText: "Disconnected",
+    headers: { "content-type": "application/json" },
+  })
+}
+
 export function nextServerAfterRemoval(
   servers: ServerConnection.Any[],
   removed: ServerConnection.Key,
