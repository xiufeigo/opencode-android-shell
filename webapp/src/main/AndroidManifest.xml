<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知：运行时申请（Android 13+）+ 回合完成后的 postMessage -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WebView 加载后端 http 地址、收 SSE/EventSource、跑 WebSocket（终端）
      都需要 INTERNET。注意这**只**开网络能力，明文范围仍由
      network_security_config 逐条限定（只回环/自建地址）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      F3 / N-2: camera, for the server pairing QR scan.

      Upstream really opens the camera: origin/v2
      packages/app/src/servers/connect/scanner.tsx:19-34 constructs a QrScanner
      over a <video> element, and :38 calls scanner.start() which calls
      getUserMedia (available because createCameraAvailability at
      packages/app/src/servers/connect/camera.ts:6 already required
      !!navigator.mediaDevices?.getUserMedia).
      WebView routes that through
      WebChromeClient.onPermissionRequest with RESOURCE_VIDEO_CAPTURE, so
      without CAMERA + an onPermissionRequest override that actually grants,
      server pairing scan cannot work in this host.

      required="false" on purpose: it must not keep camera-less devices (or
      emulator AVDs declared without one) out of the install set. Mirrors the
      native shell's app/src/main/AndroidManifest.xml:16-17 spelling.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      2026-10-06 决策记录（产品负责人拍板）：**选项 C —— 全局明文放行**，
      与官方桌面端同形态。

      为什么改：要让 App 像官方桌面端一样能直连**任意 http 服务器**，
      而不是只能连回环 / 10.0.2.2 / 逐条手写进 network_security_config 的
      自建地址。此前逐条 domain 的做法，每换一个后端地址就要改一行 XML、
      重装 APK，实测属于不可用的自缚（见 research/web/UX13_P4_CLEARTEXT_GLOBAL.md）。

      已知并被接受的代价：**所有** http:// 目标一律明文传输，
      包括公网 http 目标里的 Basic 口令。这与官方桌面端浏览器的行为一致，
      所以这是**刻意的安全姿态选择**，不是疏漏 —— 不要当成待办事项"修回去"。

      真正生效点：Android 语义下 networkSecurityConfig 存在时会**覆盖**
      manifest 的 usesCleartextTraffic，所以 res/xml/network_security_config.xml
      的 base-config cleartextTrafficPermitted 必须同步改成 true，
      两处缺一即静默回落到明文禁止。两侧由单测 CleartextPolicyTest 钉死。

      注意：明文放行**不等于**放宽证书信任。https 目标仍然只认系统 CA，
      自签证书依旧不被接受（trust-anchors 保持 system）。
    -->
    <application
        android:name=".WebHostApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher_web"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OcWebHost"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".WebHostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
